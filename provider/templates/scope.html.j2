    function renderRerunLogs(query = "") {
      const container = document.getElementById("rerun-logs-list");
      const countEl = document.getElementById("rerun-logs-count");
      const clearBtn = document.getElementById("btn-rerun-clear-filter");
      if (!container) return;

      const q = (query || "").trim().toLowerCase();
      if (clearBtn) clearBtn.style.display = q ? "inline-block" : "none";

      const filtered = RERUN_LOGS.filter(item => {
        if (!q) return true;
        return (
          item.step.toString().includes(q) ||
          item.time.toLowerCase().includes(q) ||
          item.level.toLowerCase().includes(q) ||
          item.entity.toLowerCase().includes(q) ||
          item.msg.toLowerCase().includes(q)
        );
      });

      if (countEl) {
        countEl.textContent = `${filtered.length} of ${RERUN_LOGS.length} milestones`;
      }

      if (filtered.length === 0) {
        container.innerHTML = `<div style="padding: 12px; color: var(--quake-text-muted); text-align: center; font-size: 11px;">No rerun logs matching "${query}"</div>`;
        return;
      }

      container.innerHTML = filtered.map(item => {
        const isActive = Math.abs(item.step - (state.simStep || 0)) < 60;
        const levelColor = item.level === "METRIC" ? "#38bdf8" : (item.level === "WARN" ? "#f59e0b" : "#34d399");
        const levelBg = item.level === "METRIC" ? "rgba(56, 189, 248, 0.12)" : (item.level === "WARN" ? "rgba(245, 158, 11, 0.12)" : "rgba(52, 211, 153, 0.12)");
        return `
          <div class="rerun-log-row ${isActive ? 'active' : ''}" data-step="${item.step}" style="padding: 6px 8px; border: 1px solid ${isActive ? 'var(--quake-cyan)' : 'var(--quake-border)'}; background: ${isActive ? 'rgba(56, 189, 248, 0.15)' : 'rgba(0,0,0,0.35)'}; border-radius: 4px; cursor: pointer; transition: all 0.15s ease-out;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 3px; font-size: 10px;">
              <div style="display: flex; align-items: center; gap: 6px;">
                <span style="font-family: var(--font-mono); font-weight: 700; color: var(--quake-cyan);">Step ${item.step}</span>
                <span style="color: var(--quake-text-muted); font-size: 9px;">(${item.time})</span>
              </div>
              <span style="padding: 1px 4px; background: ${levelBg}; border: 1px solid ${levelColor}; border-radius: 2px; color: ${levelColor}; font-weight: 700; font-size: 8.5px;">${item.level}</span>
            </div>
            <div style="font-size: 10px; color: var(--quake-gold); font-family: var(--font-mono); margin-bottom: 2px;">${item.entity}</div>
            <div style="font-size: 10.5px; color: var(--quake-text); line-height: 1.35;">${item.msg}</div>
          </div>
        `;
      }).join("");

      container.querySelectorAll(".rerun-log-row").forEach(row => {
        row.addEventListener("click", () => {
          const step = parseInt(row.dataset.step);
          if (!simParticlesMesh) initSimulationParticles();
          updateSimulationStep(step);
          showToast(`Scrubbed to Step ${step} (${row.querySelector("div:last-child").textContent.slice(0, 36)}...)`);
        });
      });
    }

    // PROJECT CHOOSER MODAL (GOAL 1: Run scope.py with no args)
    function setChooserLoading(isLoading, text = "", percent = 0) {
      const container = document.getElementById("chooser-loading-container");
      const textEl = document.getElementById("chooser-loading-text");
      const pctEl = document.getElementById("chooser-loading-percent");
      const barEl = document.getElementById("chooser-loading-bar");
      const submitBtn = document.getElementById("btn-chooser-submit");
      const projSel = document.getElementById("chooser-project");
      const targetSel = document.getElementById("chooser-target");
      const subSel = document.getElementById("chooser-sub");

      if (container) {
        container.style.display = isLoading ? "flex" : "none";
      }
      if (textEl && text) textEl.textContent = `◈ ${text}`;
      if (pctEl) pctEl.textContent = `${Math.round(percent)}%`;
      if (barEl) barEl.style.width = `${Math.min(100, Math.max(0, percent))}%`;

      if (submitBtn) submitBtn.disabled = isLoading;
      if (projSel) projSel.disabled = isLoading;
      if (targetSel) targetSel.disabled = isLoading;
      if (subSel) subSel.disabled = isLoading;
    }

    function openProjectChooserModal() {
      const modal = document.getElementById("modal-project-chooser");
      const projSel = document.getElementById("chooser-project");
      const targetSel = document.getElementById("chooser-target");

      if (state.projects.length === 0) {
        projSel.innerHTML = '<option value="">(Loading workspace projects...)</option>';
        targetSel.innerHTML = '<option value="">(Loading targets...)</option>';
        setChooserLoading(true, "Scanning workspace projects and targets...", 35);
      } else {
        setChooserLoading(false);
        projSel.innerHTML = "";
        state.projects.forEach(p => {
          const opt = document.createElement("option");
          opt.value = p.name;
          opt.textContent = p.name;
          if (p.name === state.currentProject) opt.selected = true;
          projSel.appendChild(opt);
        });

        if (!state.currentProject && state.projects.length > 0) {
          state.currentProject = state.projects[0].name;
          if (projSel.options.length > 0) projSel.selectedIndex = 0;
        }

        const maxStepsSel = document.getElementById("chooser-max-steps");
        if (maxStepsSel && state.maxSteps) {
          maxStepsSel.value = state.maxSteps.toString();
        }

        updateChooserTargets();
      }

      modal.classList.add("visible");
    }

    function closeProjectChooserModal() {
      const modal = document.getElementById("modal-project-chooser");
      modal.classList.remove("visible");
    }

    function updateChooserTargets() {
      const projSel = document.getElementById("chooser-project");
      const targetSel = document.getElementById("chooser-target");
      const projName = projSel.value;
      const proj = state.projects.find(p => p.name === projName);
      targetSel.innerHTML = "";
      if (!proj || !proj.targets) return;

      proj.targets.forEach(t => {
        const opt = document.createElement("option");
        opt.value = t.name;
        opt.textContent = t.name;
        if (t.name === state.currentTarget) opt.selected = true;
        targetSel.appendChild(opt);
      });

      if (!proj.targets.some(t => t.name === state.currentTarget) && proj.targets.length > 0) {
        targetSel.selectedIndex = 0;
      }

      updateChooserModesAndSubs();
    }

    function updateChooserModesAndSubs() {
      const projSel = document.getElementById("chooser-project");
      const targetSel = document.getElementById("chooser-target");
      const subSel = document.getElementById("chooser-sub");

      const projName = projSel.value;
      const targetName = targetSel.value;
      const proj = state.projects.find(p => p.name === projName);
      const target = proj?.targets?.find(t => t.name === targetName);

      subSel.innerHTML = '<option value="">(None / Entire Target)</option>';
      if (target && target.subassemblies) {
        target.subassemblies.forEach(s => {
          const opt = document.createElement("option");
          opt.value = s;
          opt.textContent = s;
          if (s === state.currentSub) opt.selected = true;
          subSel.appendChild(opt);
        });
      }

      const availableModes = target?.modes || ["CAD"];
      document.querySelectorAll("#chooser-mode-pills .mode-pill").forEach(pill => {
        const isSupp = availableModes.includes(pill.dataset.mode);
        pill.disabled = !isSupp;
        pill.classList.toggle("disabled", !isSupp);
        if (!isSupp && pill.classList.contains("active")) {
          pill.classList.remove("active");
        }
      });

      let activePill = document.querySelector("#chooser-mode-pills .mode-pill.active");
      if (!activePill || activePill.disabled) {
        const firstAvail = document.querySelector("#chooser-mode-pills .mode-pill:not(:disabled)");
        if (firstAvail) {
          document.querySelectorAll("#chooser-mode-pills .mode-pill").forEach(p => p.classList.remove("active"));
          firstAvail.classList.add("active");
          activePill = firstAvail;
        }
      }

      const isSim = activePill && activePill.dataset.mode === "SIMULATE";
      const simStepsContainer = document.getElementById("chooser-sim-steps-container");
      if (simStepsContainer) {
        simStepsContainer.style.display = isSim ? "block" : "none";
      }
    }

    function updateModePillsForActiveTarget() {
      const proj = state.projects.find(p => p.name === state.currentProject);
      const target = proj?.targets?.find(t => t.name === state.currentTarget);
      const availableModes = target?.modes || ["CAD"];

      document.querySelectorAll(".mode-pills .mode-pill").forEach(pill => {
        if (pill.closest("#modal-project-chooser")) return;
        const pillMode = pill.dataset.mode;
        const isSupported = availableModes.includes(pillMode);
        pill.disabled = !isSupported;
        pill.classList.toggle("disabled", !isSupported);
        if (!isSupported && pill.classList.contains("active")) {
          pill.classList.remove("active");
        }
      });

      // If current mode is not supported on this target, auto-select first available mode
      if (!availableModes.includes(state.currentMode)) {
        state.currentMode = availableModes[0] || "CAD";
      }

      // Update active pill styling
      document.querySelectorAll(".mode-pills .mode-pill").forEach(pill => {
        if (pill.closest("#modal-project-chooser")) return;
        pill.classList.toggle("active", pill.dataset.mode === state.currentMode);
      });

      // Update sim-bar visibility
      const simBar = document.getElementById("sim-bar");
      if (simBar) {
        simBar.classList.toggle("visible", state.currentMode === "SIMULATE");
      }
      document.body.className = "mode-" + state.currentMode.toLowerCase();
    }

    function updateActiveTargetHudBadge() {
      const badge = document.getElementById("hud-active-target");
      if (!badge) return;
      if (state.currentProject && state.currentTarget) {
        let label = `${state.currentProject} / ${state.currentTarget}`;
        if (state.currentSub) {
          label += ` : ${state.currentSub}`;
        }
        badge.textContent = label;
      } else {
        badge.textContent = "(Select Target)";
      }
    }

    // PROJECT & TARGET INITIALIZATION
    async function loadProjects(shouldLoadGeometry = true, showProgress = false, retryCount = 0) {
      try {
        setChooserLoading(true, "Discovering registered targets...", 60);
        const resp = await fetch("/api/scope/projects");
        if (!resp.ok) {
          throw new Error(`HTTP ${resp.status} ${resp.statusText}`);
        }
        const data = await resp.json();
        state.projects = data.projects || [];

        updateTargetsForActiveProject(shouldLoadGeometry, showProgress);

        // Always populate Chooser modal dropdowns
        const projSel = document.getElementById("chooser-project");
        if (projSel && state.projects.length > 0) {
          projSel.innerHTML = "";
          state.projects.forEach(p => {
            const opt = document.createElement("option");
            opt.value = p.name;
            opt.textContent = p.name;
            if (p.name === state.currentProject) opt.selected = true;
            projSel.appendChild(opt);
          });

          if (!state.currentProject && state.projects.length > 0) {
            state.currentProject = state.projects[0].name;
            if (projSel.options.length > 0) projSel.selectedIndex = 0;
          }

          updateChooserTargets();
        }

        setChooserLoading(false, "Targets ready", 100);
      } catch (err) {
        console.error("Scope load projects error:", err);
        setChooserLoading(false, "Error loading targets", 0);
        if (retryCount === 0 && showProgress) {
          console.warn("Retrying projects fetch in 1s...");
          await new Promise(r => setTimeout(r, 1000));
          return loadProjects(shouldLoadGeometry, showProgress, 1);
        }
        showToast("Error loading projects: " + (err.message || err), 3000);
      }
    }

    function updateTargetsForActiveProject(shouldLoadGeometry = true, showProgress = false) {
      const proj = state.projects.find(p => p.name === state.currentProject);
      if (!proj || !proj.targets) return;

      if (!proj.targets.some(t => t.name === state.currentTarget) && proj.targets.length > 0) {
        state.currentTarget = proj.targets[0].name;
      }

      updateActiveTargetHudBadge();
      updateModePillsForActiveTarget();

      if (shouldLoadGeometry) {
        loadActiveGeometry(showProgress);
      }
    }

    // UI SCALE MANAGEMENT
    const UI_SCALES = ["75%", "80%", "90%", "100%", "110%", "125%", "150%"];
    const UI_SCALE_KEY = "scope_ui_scale";

    function applyUiScale(scale) {
      if (!UI_SCALES.includes(scale)) {
        scale = "100%";
      }
      const factor = parseInt(scale, 10) / 100;
      if (document.documentElement) {
        document.documentElement.style.zoom = factor;
        if (factor === 1.0) {
          document.documentElement.style.width = "";
          document.documentElement.style.height = "";
        } else {
          document.documentElement.style.width = (window.innerWidth / factor) + "px";
          document.documentElement.style.height = (window.innerHeight / factor) + "px";
        }
      }
      try {
        localStorage.setItem(UI_SCALE_KEY, scale);
      } catch (e) {}
      const sel = document.getElementById("uiScaleSelect");
      if (sel && sel.value !== scale) {
        sel.value = scale;
      }
      resizeViewport();
      window.dispatchEvent(new Event("resize"));
    }

    function onUiScaleChange(scale) {
      applyUiScale(scale);
    }

    function adjustUiScale(delta) {
      let current = "100%";
      try {
        current = localStorage.getItem(UI_SCALE_KEY) || "100%";
      } catch (e) {}
      let idx = UI_SCALES.indexOf(current);
      if (idx === -1) idx = UI_SCALES.indexOf("100%");
      const nextIdx = Math.max(0, Math.min(UI_SCALES.length - 1, idx + delta));
      applyUiScale(UI_SCALES[nextIdx]);
    }

    function resetUiScale() {
      applyUiScale("100%");
    }

    function initUiScale() {
      let saved = "100%";
      try {
        saved = localStorage.getItem(UI_SCALE_KEY) || "100%";
      } catch (e) {}
      applyUiScale(saved);
    }

    // VERTICAL PANEL RESIZER / GRIPPER
    function initSidebarResizer() {
      const resizer = document.getElementById("sidebar-resizer");
      const sidebar = document.getElementById("sidebar");
      if (!resizer || !sidebar) return;

      let isResizing = false;
      let startX = 0;
      let startWidth = 0;

      // Restore saved width from localStorage if valid
      const savedWidth = localStorage.getItem("scope_sidebar_width");
      if (savedWidth) {
        const parsed = parseInt(savedWidth, 10);
        if (parsed >= 180 && parsed <= 800) {
          sidebar.style.width = parsed + "px";
        }
      }

      resizer.addEventListener("mousedown", (e) => {
        isResizing = true;
        startX = e.clientX;
        startWidth = sidebar.offsetWidth;
        resizer.classList.add("resizing");
        document.body.style.cursor = "col-resize";
        document.body.style.userSelect = "none";
      });

      window.addEventListener("mousemove", (e) => {
        if (!isResizing) return;
        const delta = e.clientX - startX;
        let newWidth = startWidth + delta;
        const minWidth = 180;
        const maxWidth = Math.min(800, window.innerWidth - 300);
        newWidth = Math.max(minWidth, Math.min(maxWidth, newWidth));
        sidebar.style.width = newWidth + "px";
        resizeViewport();
        window.dispatchEvent(new Event("resize"));
      });

      window.addEventListener("mouseup", () => {
        if (!isResizing) return;
        isResizing = false;
        resizer.classList.remove("resizing");
        document.body.style.cursor = "";
        document.body.style.userSelect = "";
        localStorage.setItem("scope_sidebar_width", sidebar.offsetWidth);
        resizeViewport();
        window.dispatchEvent(new Event("resize"));
      });

      // Double-click to reset to default 320px
      resizer.addEventListener("dblclick", () => {
        sidebar.style.width = "320px";
        localStorage.setItem("scope_sidebar_width", "320");
        resizeViewport();
        window.dispatchEvent(new Event("resize"));
      });
    }

    // EVENT LISTENERS & DOM HOOKUPS
    document.addEventListener("DOMContentLoaded", async () => {
      try {
        initUiScale();
        initSidebarResizer();
        initCadViewer();
        resizeViewport();
        updateActiveTargetHudBadge();

        if (state.currentProject && state.currentTarget) {
          showSyncProgress("INITIALIZING WORKSTATION");
          updateSyncProgress(25, "Loading Workstation...", `Preparing ${state.currentProject}/${state.currentTarget}`);
          await Promise.all([
            loadProjects(false),
            loadActiveGeometry(true),
          ]);
          hideSyncProgress();
        } else {
          // When run with no arguments, immediately pop up Target Chooser Modal before displaying anything
          openProjectChooserModal();
          await loadProjects(false);
        }
      } catch (err) {
        hideSyncProgress();
        showToast("Initialization error: " + err, 4000);
      }

      // Check for URL query parameter overrides
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.has("max_steps")) {
        const parsedSteps = parseInt(urlParams.get("max_steps"));
        if (!isNaN(parsedSteps) && parsedSteps > 0) {
          state.maxSteps = parsedSteps;
        }
      }

      // Chooser Modal Listeners
      document.getElementById("btn-open-chooser")?.addEventListener("click", openProjectChooserModal);
      document.getElementById("btn-close-chooser")?.addEventListener("click", closeProjectChooserModal);
      document.getElementById("btn-chooser-cancel")?.addEventListener("click", closeProjectChooserModal);
      document.getElementById("chooser-project")?.addEventListener("change", updateChooserTargets);
      document.getElementById("chooser-target")?.addEventListener("change", updateChooserModesAndSubs);

      document.querySelectorAll("#chooser-mode-pills .mode-pill").forEach(pill => {
        pill.addEventListener("click", () => {
          if (pill.disabled) return;
          document.querySelectorAll("#chooser-mode-pills .mode-pill").forEach(p => p.classList.remove("active"));
          pill.classList.add("active");
          const isSim = pill.dataset.mode === "SIMULATE";
          const simStepsContainer = document.getElementById("chooser-sim-steps-container");
          if (simStepsContainer) {
            simStepsContainer.style.display = isSim ? "block" : "none";
          }
        });
      });

      document.getElementById("btn-chooser-submit")?.addEventListener("click", async () => {
        const projSel = document.getElementById("chooser-project");
        const targetSel = document.getElementById("chooser-target");
        const subSel = document.getElementById("chooser-sub");
        const activePill = document.querySelector("#chooser-mode-pills .mode-pill.active");

        const selectedProj = projSel.value;
        const selectedTarget = targetSel.value;
        if (!selectedProj || !selectedTarget) {
          showToast("Please select a project and target to inspect", 3000);
          return;
        }

        state.currentProject = selectedProj;
        state.currentTarget = selectedTarget;
        state.currentSub = subSel.value || "";
        state.currentMode = activePill ? activePill.dataset.mode : "CAD";

        if (state.currentMode === "SIMULATE") {
          const stepsSel = document.getElementById("chooser-max-steps");
          if (stepsSel) {
            state.maxSteps = parseInt(stepsSel.value) || 1000;
          }
        }

        closeProjectChooserModal();

        updateActiveTargetHudBadge();
        updateModePillsForActiveTarget();

        // Update URL query params
        const simStepsParam = state.currentMode === "SIMULATE" && state.maxSteps ? `&max_steps=${state.maxSteps}` : "";
        const newUrl = `/?project=${encodeURIComponent(state.currentProject)}&target=${encodeURIComponent(state.currentTarget)}${state.currentSub ? '&subassembly=' + encodeURIComponent(state.currentSub) : ''}&mode=${encodeURIComponent(state.currentMode)}${simStepsParam}`;
        window.history.pushState(null, "", newUrl);

        showSyncProgress(`LOADING ${state.currentProject}/${state.currentTarget}`);
        try {
          await loadActiveGeometry(true);
        } finally {
          hideSyncProgress();
        }
      });

      document.getElementById("btn-sync").addEventListener("click", async () => {
        showSyncProgress("SYNCHRONIZING WORKSTATION");
        try {
          updateSyncProgress(20, "Invalidating Caches...", "Flushing provider manifests and geometry cache");
          await fetch("/api/scope/sync");

          updateSyncProgress(45, "Discovering Assets...", "Querying registered targets and components");
          await loadProjects(false);

          updateSyncProgress(70, "Compiling Geometry...", `Generating 3D model for ${state.currentTarget || state.currentProject}`);
          await loadActiveGeometry(true);

          updateSyncProgress(100, "Synchronized", "Workstation ready");
          showToast("Workstation synchronized.", 2000);
        } catch (err) {
          showToast(`Sync failed: ${err}`, 4000);
        } finally {
          hideSyncProgress();
        }
      });

      // Mode switch pills
      document.querySelectorAll(".mode-pills .mode-pill").forEach(pill => {
        if (pill.closest("#modal-project-chooser")) return;
        pill.addEventListener("click", async () => {
          if (pill.disabled) return;
          document.querySelectorAll(".mode-pills .mode-pill").forEach(p => {
            if (!p.closest("#modal-project-chooser")) p.classList.remove("active");
          });
          pill.classList.add("active");
          state.currentMode = pill.dataset.mode;
          document.body.className = "mode-" + state.currentMode.toLowerCase();

          // Toggle Sim Bar
          document.getElementById("sim-bar").classList.toggle("visible", state.currentMode === "SIMULATE");
          updateSidebarModeTabs();
          showSyncProgress(`SWITCHING TO ${state.currentMode} MODE`);
          try {
            await loadActiveGeometry(true);
          } finally {
            hideSyncProgress();
          }
        });
      });

      // Camera Toolbar Buttons
      document.getElementById("cam-iso")?.addEventListener("click", () => setCameraPreset("iso"));
      document.getElementById("cam-top")?.addEventListener("click", () => setCameraPreset("top"));
      document.getElementById("cam-bottom")?.addEventListener("click", () => setCameraPreset("bottom"));
      document.getElementById("cam-flip")?.addEventListener("click", flipPcbView);
      document.getElementById("cam-front")?.addEventListener("click", () => setCameraPreset("front"));
      document.getElementById("cam-right")?.addEventListener("click", () => setCameraPreset("right"));
      document.getElementById("cam-ortho")?.addEventListener("click", toggleProjection);
      document.getElementById("cam-wire")?.addEventListener("click", toggleWireframe);
      document.getElementById("cam-focus")?.addEventListener("click", () => {
        if (state.viewer && state.viewer.controls && state.viewer.controls.reset) state.viewer.controls.reset();
      });

      // PCB Layer & Mode Control Buttons
      document.getElementById("btn-all-layers")?.addEventListener("click", () => setAllLayersVisible(true));
      document.getElementById("btn-flip-pcb")?.addEventListener("click", flipPcbView);
      const rulerBtn = document.getElementById("cam-ruler");
      let rulerActive = false;
      if (rulerBtn) {
        rulerBtn.addEventListener("click", () => {
          rulerActive = !rulerActive;
          rulerBtn.classList.toggle("active", rulerActive);
          if (state.display && typeof state.display.setTool === "function") {
            state.display.setTool("distance", rulerActive);
            if (state.display.clickButtons && state.display.clickButtons["distance"]) {
              state.display.clickButtons["distance"].set(rulerActive);
            }
          }
          showToast(rulerActive ? "Ruler tool active (mm): Click two points to measure distance" : "Ruler tool deactivated");
        });
      }

      // Left Panel Display Controls (BUG-BRIGHT-STAGBEETLE-720)
      document.getElementById("btn-view-iso")?.addEventListener("click", () => setCameraPreset("iso"));
      document.getElementById("btn-view-top")?.addEventListener("click", () => setCameraPreset("top"));
      document.getElementById("btn-view-front")?.addEventListener("click", () => setCameraPreset("front"));
      document.getElementById("btn-view-right")?.addEventListener("click", () => setCameraPreset("right"));
      document.getElementById("btn-view-bottom")?.addEventListener("click", () => setCameraPreset("bottom"));
      document.getElementById("btn-view-left")?.addEventListener("click", () => setCameraPreset("left"));
      document.getElementById("btn-view-ortho")?.addEventListener("click", toggleProjection);
      document.getElementById("btn-view-wire")?.addEventListener("click", toggleWireframe);
      document.getElementById("btn-view-axes")?.addEventListener("click", toggleAxes);
      document.getElementById("btn-view-grid")?.addEventListener("click", toggleGrid);
      document.getElementById("view-explode-slider")?.addEventListener("input", (e) => {
        setExplode(e.target.value);
      });

      // Netlist Search & Clear Highlighting
      document.getElementById("net-search")?.addEventListener("input", () => {
        updateNetsList();
      });
      document.getElementById("btn-clear-net-highlight")?.addEventListener("click", () => {
        clearNetHighlight();
      });

      // Markup Toolbar Toggles & Buttons
      document.getElementById("btn-toggle-markup")?.addEventListener("click", () => {
        const tb = document.getElementById("markup-toolbar");
        tb.classList.toggle("visible");
        markupCanvas.classList.toggle("active", tb.classList.contains("visible"));
      });

      document.querySelectorAll(".tool-btn[data-tool]").forEach(btn => {
        btn.addEventListener("click", () => {
          document.querySelectorAll(".tool-btn[data-tool]").forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          state.activeTool = btn.dataset.tool;
        });
      });

      document.querySelectorAll(".color-swatch").forEach(swatch => {
        swatch.addEventListener("click", () => {
          document.querySelectorAll(".color-swatch").forEach(s => s.classList.remove("active"));
          swatch.classList.add("active");
          state.activeColor = swatch.dataset.color;
        });
      });

      document.getElementById("btn-clear-markup")?.addEventListener("click", clearMarkups);
      document.getElementById("btn-undo-markup")?.addEventListener("click", undoMarkup);

      // Shortcuts Toggle in Viewport
      document.getElementById("btn-shortcuts")?.addEventListener("click", () => toggleShortcuts());
      document.getElementById("btn-close-shortcuts-hud")?.addEventListener("click", () => toggleShortcuts(false));

      // Target Bug Modal
      document.getElementById("btn-target-bug")?.addEventListener("click", openTargetBugModal);
      document.getElementById("btn-close-bug")?.addEventListener("click", () => {
        document.getElementById("modal-bug").classList.remove("visible");
      });
      document.getElementById("btn-cancel-bug")?.addEventListener("click", () => {
        document.getElementById("modal-bug").classList.remove("visible");
      });
      document.getElementById("btn-submit-bug")?.addEventListener("click", submitBugReport);

      // Sidebar Tabs
      document.querySelectorAll(".sidebar-tab").forEach(tab => {
        tab.addEventListener("click", () => {
          document.querySelectorAll(".sidebar-tab").forEach(t => t.classList.remove("active"));
          document.querySelectorAll(".tab-pane").forEach(p => p.classList.remove("active"));
          tab.classList.add("active");
          document.getElementById(tab.dataset.pane)?.classList.add("active");
        });
      });

      // Simulation Bar Scrubber Controls (BUG-LUSTROUS-MANTIS-333)
      document.getElementById("btn-sim-play")?.addEventListener("click", toggleSimPlay);
      document.getElementById("btn-sim-prev")?.addEventListener("click", () => {
        const nextStep = Math.max(0, state.simStep - 15);
        if (!simParticlesMesh) initSimulationParticles();
        updateSimulationStep(nextStep);
      });
      document.getElementById("btn-sim-next")?.addEventListener("click", () => {
        const nextStep = (state.simStep + 15) % (state.maxSteps || 1000);
        if (!simParticlesMesh) initSimulationParticles();
        updateSimulationStep(nextStep);
      });
      document.getElementById("sim-step-slider")?.addEventListener("input", (e) => {
        const nextStep = parseInt(e.target.value);
        if (!simParticlesMesh) initSimulationParticles();
        updateSimulationStep(nextStep);
      });
      document.querySelectorAll(".sim-log-chip").forEach(chip => {
        chip.addEventListener("click", () => {
          const step = parseInt(chip.dataset.step);
          if (!simParticlesMesh) initSimulationParticles();
          updateSimulationStep(step);
          showToast(`Scrubbed to Rerun milestone: ${chip.textContent}`);
        });
      });

      // Rerun Logs Filter & Search (BUG-JUMPING-INSTAR-950)
      document.getElementById("rerun-search")?.addEventListener("input", (e) => {
        renderRerunLogs(e.target.value);
      });
      document.getElementById("btn-rerun-clear-filter")?.addEventListener("click", () => {
        const input = document.getElementById("rerun-search");
        if (input) input.value = "";
        renderRerunLogs("");
      });

      // Synchronize text input with selected pin or selected text markup
      const txtInput = document.getElementById("markup-text-input");
      if (txtInput) {
        txtInput.addEventListener("input", (e) => {
          const val = e.target.value;
          if (state.selectedPin) {
            state.selectedPin.text = val;
            const inlineInput = document.querySelector(`.pin-item[data-id="${state.selectedPin.id}"] .pin-note-input`);
            if (inlineInput && inlineInput.value !== val) {
              inlineInput.value = val;
            }
            redrawMarkups();
          } else if (state.selectedMarkup) {
            state.selectedMarkup.text = val;
            redrawMarkups();
          }
        });
      }

      // UI Scale & Navigation Global Shortcuts
      document.addEventListener("keydown", (e) => {
        if (e.metaKey || e.ctrlKey) {
          if (e.key === "=" || e.key === "+" || e.code === "Equal" || e.code === "NumpadAdd") {
            e.preventDefault();
            adjustUiScale(1);
            return;
          }
          if (e.key === "-" || e.key === "_" || e.code === "Minus" || e.code === "NumpadSubtract") {
            e.preventDefault();
            adjustUiScale(-1);
            return;
          }
          if (e.key === "0" || e.code === "Digit0" || e.code === "Numpad0") {
            e.preventDefault();
            resetUiScale();
            return;
          }
        }
      });
    });
  </script>
</body>
</html>
