{# Reusable Quake Diff Rendering Component Styling (JS logic lives in /js/diff/diff_engine.js) #}
<style>
  /* Diff Viewer Styles */
  .diff-workstation-panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--quake-panel, #1b120a);
    border: 2px solid var(--quake-border-mid, #5a381e);
    border-radius: 4px;
    box-shadow: inset 1px 1px 0px var(--quake-border-light, #8d5d33), inset -1px -1px 0px var(--quake-border-dark, #120a05);
  }

  .diff-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    background: var(--quake-header-bg, #291a10);
    border-bottom: 2px solid var(--quake-border-mid, #5a381e);
    gap: 10px;
    flex-shrink: 0;
    flex-wrap: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    white-space: nowrap;
    scrollbar-width: thin;
  }

  .diff-file-title {
    font-size: 10px;
    font-weight: 700;
    color: var(--quake-gold, #ffb800);
    display: flex;
    align-items: center;
    gap: 8px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .diff-stats-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 9px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 3px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--quake-border-mid, #5a381e);
  }

  .diff-stats-add { color: #22c55e; }
  .diff-stats-del { color: #ef4444; }

  .diff-mode-controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .diff-scroll-body {
    flex: 1;
    overflow-x: auto;
    overflow-y: auto;
    background: #0f0a07;
    position: relative;
    scrollbar-width: thin;
    scrollbar-color: var(--quake-copper, #c87a32) #1e130b;
  }

  .diff-scroll-body::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }

  .diff-scroll-body::-webkit-scrollbar-track {
    background: #1e130b;
    border: 1px solid #3d2311;
  }

  .diff-scroll-body::-webkit-scrollbar-thumb {
    background: #965a25;
    border-radius: 4px;
    border: 1px solid #c87a32;
  }

  .diff-scroll-body::-webkit-scrollbar-thumb:hover {
    background: var(--quake-gold, #ffb800);
    border-color: #ffd700;
    box-shadow: 0 0 6px rgba(255, 184, 0, 0.4);
  }

  /* Side-by-side Table */
  .diff-sbs-table {
    border-collapse: collapse;
    width: 100% !important;
    min-width: 100% !important;
    table-layout: fixed !important;
    font-family: var(--font-mono, monospace);
    font-size: 9px;
    line-height: 1.45;
  }

  .diff-sbs-table thead th {
    background: #23160e;
    color: var(--quake-copper, #c87a32);
    font-size: 8px;
    text-transform: uppercase;
    padding: 4px 8px;
    border-bottom: 1px solid var(--quake-border-mid, #5a381e);
    position: sticky;
    top: 0;
    z-index: 5;
    text-align: left;
  }

  .diff-sbs-table thead th.th-old {
    position: relative;
    border-right: 2px solid var(--quake-border-accent, #8d5d33);
  }

  .sbs-split-resizer {
    position: absolute;
    top: 0;
    right: -6px;
    width: 12px;
    height: 100%;
    cursor: col-resize;
    z-index: 25;
    user-select: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sbs-split-resizer::before {
    content: "⋮";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 10px;
    line-height: 1;
    color: var(--quake-gold, #ffb800);
    z-index: 26;
    pointer-events: none;
    text-shadow: 0 0 3px rgba(0, 0, 0, 0.9);
    font-weight: bold;
  }

  .sbs-split-resizer::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 5px;
    width: 2px;
    background: var(--quake-border-accent, #8d5d33);
    transition: background 0.15s, width 0.15s, left 0.15s;
  }

  .sbs-split-resizer:hover::after,
  .sbs-split-resizer.resizing::after {
    background: var(--quake-gold, #ffb800);
    width: 4px;
    left: 4px;
  }

  .sbs-split-resizer:hover::before,
  .sbs-split-resizer.resizing::before {
    color: #fff;
  }

  .diff-sbs-row td.old-code {
    border-right: 2px solid var(--quake-border-accent, #8d5d33);
    position: relative;
  }

  .diff-sbs-row td.old-code:hover {
    border-right-color: var(--quake-gold, #ffb800);
  }

  .diff-sbs-row td {
    padding: 1px 4px;
    vertical-align: top;
    white-space: pre;
    font-family: inherit;
  }

  .diff-lineno {
    width: 44px;
    user-select: none;
    text-align: right;
    color: var(--quake-text-dim, #716053);
    padding-right: 8px !important;
    border-right: 1px solid rgba(90, 56, 30, 0.4);
    background: rgba(0, 0, 0, 0.3);
    cursor: pointer;
    flex-shrink: 0;
  }

  .diff-lineno:hover {
    color: var(--quake-gold, #ffb800);
    background: rgba(255, 184, 0, 0.15);
  }

  .diff-marker-cell {
    width: 20px;
    user-select: none;
    text-align: center;
    font-weight: 700;
    color: var(--quake-text-dim, #716053);
    background: rgba(0, 0, 0, 0.25);
    border-right: 1px solid rgba(90, 56, 30, 0.25);
    padding: 1px 2px !important;
    cursor: pointer;
  }

  .diff-code-cell {
    overflow-x: hidden;
    font-family: inherit;
    white-space: pre;
    max-width: 900px;
  }

  /* Word Wrap in Diff Views (BUG-245, BUG-252) */
  .diff-word-wrap .diff-sbs-row td.diff-code-cell,
  .diff-word-wrap .diff-sbs-row td.old-code,
  .diff-word-wrap .diff-sbs-row td.new-code,
  .diff-word-wrap .diff-unified-text,
  .diff-word-wrap .diff-full-text {
    white-space: pre-wrap !important;
    word-break: break-word !important;
    overflow-wrap: anywhere !important;
    max-width: none !important;
    min-width: 0 !important;
  }

  .diff-word-wrap .diff-unified-wrap,
  .diff-word-wrap .diff-full-wrap {
    width: 100% !important;
    min-width: 100% !important;
    max-width: 100% !important;
  }

  .diff-sbs-row.row-delete td.old-code,
  .diff-sbs-row.row-delete td.old-lineno,
  .diff-sbs-row.row-delete td.old-marker,
  .diff-sbs-row.row-del td.old-code,
  .diff-sbs-row.row-del td.old-lineno,
  .diff-sbs-row.row-del td.old-marker {
    background: rgba(239, 68, 68, 0.22);
    color: #fca5a5;
  }

  .diff-sbs-row.row-insert td.new-code,
  .diff-sbs-row.row-insert td.new-lineno,
  .diff-sbs-row.row-insert td.new-marker,
  .diff-sbs-row.row-add td.new-code,
  .diff-sbs-row.row-add td.new-lineno,
  .diff-sbs-row.row-add td.new-marker {
    background: rgba(34, 197, 94, 0.22);
    color: #86efac;
  }

  .diff-sbs-row.row-replace td.old-code,
  .diff-sbs-row.row-replace td.old-marker {
    background: rgba(239, 68, 68, 0.22);
    color: #fca5a5;
  }

  .diff-sbs-row.row-replace td.new-code,
  .diff-sbs-row.row-replace td.new-marker {
    background: rgba(34, 197, 94, 0.22);
    color: #86efac;
  }

  /* Unified View */
  .diff-unified-wrap {
    padding: 10px 14px;
    min-width: 100%;
    width: max-content;
    font-family: var(--font-mono, monospace);
    font-size: 9px;
    line-height: 1.45;
  }

  .diff-unified-hunk-bar {
    background: #201309;
    border-left: 3px solid var(--quake-gold, #ffb800);
    color: var(--quake-gold, #ffb800);
    padding: 4px 8px;
    margin: 8px 0 4px 0;
    font-size: 9px;
    font-weight: 700;
  }

  .diff-unified-row {
    display: grid;
    grid-template-columns: 44px 44px 22px 1fr;
    cursor: pointer;
    padding: 1px 0;
    border-radius: 2px;
  }

  .diff-unified-num-old {
    grid-column: 1;
    width: 44px;
    text-align: right;
    padding-right: 6px;
    user-select: none;
    color: var(--quake-text-dim, #716053);
    flex-shrink: 0;
  }

  .diff-unified-num-new {
    grid-column: 2;
    width: 44px;
    text-align: right;
    padding-right: 6px;
    user-select: none;
    color: var(--quake-text-dim, #716053);
    flex-shrink: 0;
  }

  .diff-unified-marker {
    grid-column: 3;
    width: 22px;
    text-align: center;
    user-select: none;
    font-weight: 700;
    color: var(--quake-text-dim, #716053);
    background: rgba(0, 0, 0, 0.25);
    border-right: 1px solid rgba(90, 56, 30, 0.25);
    flex-shrink: 0;
  }

  .diff-unified-text {
    grid-column: 4;
    min-width: 0;
    white-space: pre;
    word-break: normal;
    padding-left: 8px;
  }

  .diff-unified-row.add,
  .diff-unified-row.insert,
  .diff-unified-row.row-add,
  .diff-unified-row.row-insert {
    background: rgba(34, 197, 94, 0.22);
    color: #86efac;
  }
  .diff-unified-row.del,
  .diff-unified-row.delete,
  .diff-unified-row.row-del,
  .diff-unified-row.row-delete {
    background: rgba(239, 68, 68, 0.22);
    color: #fca5a5;
  }
  .diff-unified-row.del .diff-unified-marker,
  .diff-unified-row.delete .diff-unified-marker,
  .diff-unified-row.row-del .diff-unified-marker,
  .diff-unified-row.row-delete .diff-unified-marker { color: #fca5a5; }
  .diff-unified-row.add .diff-unified-marker,
  .diff-unified-row.insert .diff-unified-marker,
  .diff-unified-row.row-add .diff-unified-marker,
  .diff-unified-row.row-insert .diff-unified-marker { color: #86efac; }

  /* Full File View */
  .diff-full-wrap {
    padding: 10px 14px;
    min-width: 100%;
    font-family: var(--font-mono, monospace);
    font-size: 9px;
    line-height: 1.45;
  }

  .diff-full-num {
    width: 48px;
    user-select: none;
    text-align: right;
    color: var(--quake-text-dim, #716053);
    padding-right: 12px;
    border-right: 1px solid rgba(90, 56, 30, 0.4);
    flex-shrink: 0;
  }

  .diff-full-text {
    padding-left: 10px;
    white-space: pre;
    overflow-x: hidden;
  }

  /* Binary Diff Presentation */
  .diff-binary-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    text-align: center;
    gap: 16px;
    color: var(--quake-text-muted, #9e8a78);
  }

  .diff-binary-icon {
    font-size: 26px;
    color: var(--quake-amber, #e59400);
  }

  .diff-binary-links {
    display: flex;
    gap: 12px;
  }

  .diff-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--quake-text-dim, #716053);
    font-size: 9px;
    gap: 8px;
  }
</style>
