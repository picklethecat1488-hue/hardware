<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Diff Viewer &amp; Smartlog: {{ session.repo_name }}</title>
  <meta name="theme-color" content="#291a10">
  <meta name="color-scheme" content="dark">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Quake">
  <link rel="manifest" href="/static/manifest.json">
  <link rel="icon" type="image/svg+xml" href="/static/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/static/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/static/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/static/apple-touch-icon.png">
  <link rel="shortcut icon" href="/static/favicon.ico">
  <link rel="stylesheet" href="/static/common.css">
  <script src="/static/vendor/highlight/highlight.js"></script>
  <style>
    html { font-size: 80%; }
    :root {
      --quake-bg: #120c08;
      --quake-panel: #1b120a;
      --quake-panel-hover: #261a0f;
      --quake-header-bg: #291a10;
      --quake-border-light: #8d5d33;
      --quake-border-mid: #5a381e;
      --quake-border-dark: #120a05;

      --quake-gold: #ffb800;
      --quake-gold-dim: #c98c00;
      --quake-amber: #e59400;
      --quake-copper: #c87a32;
      --quake-red: #ef4444;
      --quake-green: #22c55e;
      --quake-cyan: #38bdf8;
      --quake-purple: #c084fc;
      --quake-text-light: #dedede;
      --quake-text-muted: #9e8a78;
      --quake-text-dim: #716053;

      --font-mono: ui-monospace, "SF Mono", "Courier New", "Lucida Console", monospace;
      --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html {
      height: 100%;
      width: 100%;
    }

    body {
      background-color: var(--quake-bg);
      background-image:
        repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.45) 0px, rgba(0, 0, 0, 0.45) 2px, transparent 2px, transparent 4px),
        radial-gradient(ellipse at 50% 0%, #2e1d13 0%, #0d0704 100%);
      color: var(--quake-text-light);
      font-family: var(--font-mono);
      letter-spacing: 0.02em;
      height: 100%;
      width: 100%;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      border: 2px solid var(--quake-border-mid);
      box-shadow: inset 0 0 0 1px rgba(255, 184, 0, 0.2), 0 0 10px rgba(200, 122, 50, 0.1);
    }

    html.in-iframe,
    html.in-iframe body,
    body.in-iframe {
      border: none !important;
      box-shadow: none !important;
    }
    html.in-iframe .window-resize-gripper,
    body.in-iframe .window-resize-gripper,
    .in-iframe .window-resize-gripper {
      display: none !important;
    }

    /* Window Resize Gripper (WORM-027) */
    .window-resize-gripper {
      position: fixed;
      bottom: 2px;
      right: 2px;
      width: 16px;
      height: 16px;
      cursor: nwse-resize;
      z-index: 99999;
      pointer-events: none;
      background:
        linear-gradient(135deg, transparent 0%, transparent 40%, var(--quake-border-mid) 40%, var(--quake-border-mid) 50%, transparent 50%, transparent 65%, var(--quake-border-light) 65%, var(--quake-border-light) 75%, transparent 75%, transparent 90%, var(--quake-gold) 90%, var(--quake-gold) 100%);
      opacity: 0.85;
      filter: drop-shadow(0 0 2px var(--quake-gold));
    }

    /* Quake Card & Bevels */
    .quake-card {
      background-color: var(--quake-panel);
      border: 2px solid var(--quake-border-mid);
      box-shadow: inset 1px 1px 0px var(--quake-border-light), inset -1px -1px 0px var(--quake-border-dark), 0 6px 18px rgba(0,0,0,0.85);
      border-radius: 4px;
    }

    /* Buttons */
    .quake-btn {
      font-family: var(--font-mono);
      letter-spacing: 0.04em;
      text-transform: uppercase;
      font-weight: 700;
      font-size: 9px;
      padding: 5px 10px;
      border-radius: 3px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: all 0.15s ease;
      text-decoration: none;
      white-space: nowrap !important;
      flex-shrink: 0;
    }
    .quake-btn * {
      white-space: nowrap !important;
    }
    .quake-btn-default {
      background: linear-gradient(180deg, #3a2618 0%, #20140c 100%);
      border: 2px solid;
      border-color: #7d4e28 #1a0f07 #1a0f07 #7d4e28;
      color: #d6c6b2;
      box-shadow: inset 1px 1px 0 #9c6838, 0 3px 6px rgba(0,0,0,0.7);
    }
    .quake-btn-default:hover {
      background: linear-gradient(180deg, #4d3320 0%, #2c1c11 100%);
      border-color: #9c6838 #1a0f07 #1a0f07 #9c6838;
      color: var(--quake-gold);
      text-shadow: 0 0 6px rgba(255, 184, 0, 0.4);
    }
    .quake-btn-gold {
      background: linear-gradient(180deg, #664614 0%, #3d2807 100%);
      border: 2px solid;
      border-color: #a8792a #1c1102 #1c1102 #a8792a;
      color: #ffe699;
      box-shadow: inset 1px 1px 0 #d49d3b, 0 3px 6px rgba(0,0,0,0.7);
    }
    .quake-btn-gold:hover {
      background: linear-gradient(180deg, #7d5718 0%, #4a3209 100%);
      border-color: #c99333 #1c1102 #1c1102 #c99333;
      color: #fff2cc;
      text-shadow: 0 0 8px rgba(255, 184, 0, 0.6);
    }
    .quake-btn-red {
      background: linear-gradient(180deg, #4a1515 0%, #2a0b0b 100%);
      border: 2px solid;
      border-color: #8c2e2e #1a0606 #1a0606 #8c2e2e;
      color: #fca5a5;
      box-shadow: inset 1px 1px 0 #b33b3b, 0 3px 6px rgba(0,0,0,0.7);
    }
    .quake-btn-red:hover {
      background: linear-gradient(180deg, #5c1b1b 0%, #350e0e 100%);
      color: #ffffff;
      text-shadow: 0 0 6px rgba(239, 68, 68, 0.5);
    }
    .quake-btn-sm {
      padding: 2px 6px;
      font-size: 8px;
    }
    .quake-btn-icon {
      padding: 2px 6px;
      min-width: 24px;
      justify-content: center;
      font-size: 9px;
    }

    /* Top HUD */
    .quake-hud {
      background: var(--quake-header-bg);
      border-bottom: 2px solid var(--quake-border-mid);
      box-shadow: inset 0 1px 0 var(--quake-border-light), 0 4px 12px rgba(0, 0, 0, 0.6);
      padding: 8px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-shrink: 0;
      z-index: 10;
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      white-space: nowrap;
      scrollbar-width: thin;
    }

    .quake-logo-zone {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .quake-logo-badge {
      background: #3d2311;
      border: 1px solid var(--quake-gold);
      color: var(--quake-gold);
      font-weight: 900;
      padding: 3px 8px;
      font-size: 10px;
      letter-spacing: 0.1em;
      text-shadow: 0 0 8px rgba(255, 184, 0, 0.5);
    }
    .quake-logo-sub {
      color: var(--quake-copper);
      font-size: 9px;
      font-weight: 700;
    }

    .hud-controls {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .quake-select {
      background: #1a0f07;
      border: 1px solid var(--quake-border-light);
      color: var(--quake-gold);
      font-family: var(--font-mono);
      font-size: 9px;
      padding: 4px 8px;
      border-radius: 3px;
      outline: none;
      cursor: pointer;
    }
    .quake-select option {
      background: #1b120a;
      color: var(--quake-text-light);
    }

    /* Main Layout */
    .app-workspace {
      flex: 1;
      display: flex;
      gap: 10px;
      padding: 10px;
      overflow: hidden;
    }

    /* Column Containers */
    .column-panel {
      display: flex;
      flex-direction: column;
      overflow: hidden;
      height: 100%;
    }
    .pane-smartlog {
      width: 330px;
      min-width: 180px;
      max-width: 800px;
      flex-shrink: 0;
      transition: width 0.2s ease, opacity 0.2s ease;
      overflow: hidden;
    }
    .pane-smartlog.resizing,
    .pane-files.resizing {
      transition: none !important;
    }
    .pane-smartlog.collapsed {
      width: 0 !important;
      min-width: 0 !important;
      padding: 0 !important;
      border: none !important;
      opacity: 0;
      pointer-events: none;
      margin-right: -10px !important;
    }
    .pane-smartlog .column-header,
    .pane-smartlog .column-scroll,
    .pane-smartlog > div,
    .pane-files .column-header,
    .pane-files .column-scroll,
    .pane-files > div {
      min-width: 0;
      width: 100%;
    }

    .pane-files {
      width: 270px;
      min-width: 160px;
      max-width: 700px;
      flex-shrink: 0;
      transition: width 0.2s ease, opacity 0.2s ease;
      overflow: hidden;
    }
    .pane-files.collapsed {
      width: 0 !important;
      min-width: 0 !important;
      padding: 0 !important;
      border: none !important;
      opacity: 0;
      pointer-events: none;
      margin-right: -10px !important;
    }

    .column-resizer {
      width: 6px;
      cursor: col-resize;
      background: var(--quake-border-mid);
      position: relative;
      flex-shrink: 0;
      z-index: 10;
      transition: background 0.15s ease, box-shadow 0.15s ease;
      user-select: none;
    }
    .column-resizer:hover, .column-resizer.resizing {
      background: var(--quake-gold);
      box-shadow: 0 0 8px rgba(255, 184, 0, 0.7);
    }
    .column-resizer.hidden {
      display: none !important;
    }

    /* Branch formatting UI styles (BUG-197) */
    .branch-group-list {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 6px;
      background: #110a05;
      border: 1px solid var(--quake-border-mid);
      border-radius: 3px;
    }
    .branch-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 6px 10px;
      border-radius: 3px;
      background: #180f08;
      border: 1px solid var(--quake-border-dark);
      cursor: pointer;
      font-size: 9px;
      transition: all 0.15s ease;
    }
    .branch-item:hover {
      background: #2b1a0d;
      border-color: var(--quake-border-light);
      color: var(--quake-gold);
    }
    .branch-item.active {
      border-color: var(--quake-gold);
      background: #2c1a06;
      box-shadow: inset 1px 1px 0 #5c3b0f;
    }
    .branch-item-main {
      background: linear-gradient(90deg, #2b1a0a 0%, #1a1006 100%);
      border-color: #8d5d33;
      font-weight: 700;
    }
    .branch-item-main:hover {
      background: linear-gradient(90deg, #3d250f 0%, #29180a 100%);
      border-color: var(--quake-gold);
    }

    /* Jump to CR Button & Badges (BUG-199) */
    .jump-cr-btn {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 2px 6px;
      font-size: 8px;
    }
    .jump-cr-btn.cr-reviewed {
      background: linear-gradient(180deg, #1b3818 0%, #0d1e0d 100%);
      border-color: #22c55e #0a140a #0a140a #22c55e;
      color: #86efac;
    }
    .cr-badge {
      display: inline-block;
      font-size: 7.5px;
      font-weight: 700;
      padding: 1px 4px;
      border-radius: 2px;
      line-height: 1;
    }
    .cr-badge.cr-open {
      background: var(--quake-amber);
      color: #120a05;
    }
    .cr-badge.cr-resolved {
      background: #166534;
      color: #bbf7d0;
    }

    .pane-diff {
      flex: 1;
      min-width: 0;
    }
    .column-header {
      background: var(--quake-header-bg);
      border-bottom: 2px solid var(--quake-border-mid);
      padding: 8px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 9px;
      font-weight: 700;
      color: var(--quake-gold);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      flex-shrink: 0;
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      white-space: nowrap;
      scrollbar-width: thin;
      gap: 8px;
    }
    .column-header > span,
    .column-header > div {
      white-space: nowrap;
      flex-shrink: 0;
    }
    .commit-toolbar {
      display: flex;
      gap: 6px;
      padding: 6px 8px;
      background: #150d07;
      border-bottom: 1px solid var(--quake-border-mid);
      align-items: center;
      justify-content: space-between;
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      white-space: nowrap;
      scrollbar-width: thin;
      flex-shrink: 0;
    }
    .commit-toolbar > div {
      display: flex;
      gap: 6px;
      align-items: center;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .diff-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 12px;
      background: var(--quake-header-bg, #291a10);
      border-bottom: 2px solid var(--quake-border-mid, #5a381e);
      gap: 10px;
      flex-shrink: 0;
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      white-space: nowrap;
      scrollbar-width: thin;
    }
    .diff-toolbar > div {
      white-space: nowrap;
      flex-shrink: 0;
    }
    /* Visible Quake Scrollbars (BUG-202) */
    * {
      scrollbar-width: thin;
      scrollbar-color: var(--quake-copper, #c87a32) #1e130b;
    }
    ::-webkit-scrollbar {
      width: 10px;
      height: 10px;
    }
    ::-webkit-scrollbar-track {
      background: #1e130b;
      border: 1px solid #3d2311;
    }
    ::-webkit-scrollbar-thumb {
      background: #965a25;
      border-radius: 4px;
      border: 1px solid #c87a32;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: var(--quake-gold, #ffb800);
      border-color: #ffd700;
      box-shadow: 0 0 6px rgba(255, 184, 0, 0.4);
    }

    .column-scroll {
      flex: 1;
      overflow-y: scroll;
      scrollbar-gutter: stable;
      padding: 8px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    /* Smartlog DAG nodes */
    .smartlog-node {
      background: #160e07;
      border: 1px solid var(--quake-border-mid);
      border-radius: 3px;
      padding: 8px 10px;
      cursor: pointer;
      transition: all 0.15s ease;
      display: flex;
      flex-direction: column;
      gap: 4px;
      position: relative;
    }
    .smartlog-node:hover {
      background: var(--quake-panel-hover);
      border-color: var(--quake-copper);
    }
    .smartlog-node.active {
      background: linear-gradient(90deg, rgba(255, 184, 0, 0.22) 0%, rgba(27, 18, 10, 0.85) 100%) !important;
      border-left: 4px solid var(--quake-gold, #ffb800) !important;
      box-shadow: inset 3px 0 0 var(--quake-gold, #ffb800), 0 0 10px rgba(255, 184, 0, 0.3) !important;
    }
    .smartlog-node.selected {
      background: linear-gradient(90deg, rgba(255, 184, 0, 0.16) 0%, rgba(200, 122, 50, 0.12) 50%, rgba(27, 18, 10, 0.90) 100%) !important;
      border-left: 4px solid var(--quake-amber, #e59400) !important;
      border-top: 1px solid rgba(255, 184, 0, 0.3) !important;
      border-bottom: 1px solid rgba(255, 184, 0, 0.3) !important;
      box-shadow: inset 3px 0 0 var(--quake-amber, #e59400), 0 0 8px rgba(229, 148, 0, 0.25) !important;
    }
    .smartlog-node.selected:hover {
      background: linear-gradient(90deg, rgba(255, 184, 0, 0.24) 0%, rgba(200, 122, 50, 0.16) 50%, rgba(38, 26, 15, 0.95) 100%) !important;
    }
    .smartlog-node.selected.active {
      background: linear-gradient(90deg, rgba(255, 184, 0, 0.32) 0%, rgba(200, 122, 50, 0.20) 40%, rgba(27, 18, 10, 0.95) 100%) !important;
      border-left: 4px solid var(--quake-gold, #ffb800) !important;
      border-top: 1px solid rgba(255, 184, 0, 0.5) !important;
      border-bottom: 1px solid rgba(255, 184, 0, 0.5) !important;
      box-shadow: inset 4px 0 0 var(--quake-gold, #ffb800), 0 0 14px rgba(255, 184, 0, 0.45) !important;
    }
    .smartlog-node.active .node-sha,
    .smartlog-node.selected .node-sha {
      color: var(--quake-gold, #ffb800) !important;
      font-weight: 700;
      text-shadow: 0 0 6px rgba(255, 184, 0, 0.6);
    }
    .smartlog-node.active .node-subject,
    .smartlog-node.selected .node-subject {
      color: #ffffff !important;
      font-weight: 600;
    }
    .smartlog-node.head-node {
      border-left: 3px solid var(--quake-cyan);
    }
    .smartlog-node.ancestor-top-node {
      border-left: 3px solid #38bdf8 !important;
      background: rgba(56, 189, 248, 0.05);
    }
    .node-badge-ancestor {
      background: #1b2a32 !important;
      color: #38bdf8 !important;
      border: 1px solid #0284c7 !important;
      font-weight: 700 !important;
    }

    .node-header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 9px;
      gap: 6px;
    }
    .node-graph-art {
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--quake-gold);
      white-space: pre;
    }
    .node-sha {
      color: var(--quake-amber);
      font-weight: 700;
    }
    .node-author-date {
      color: var(--quake-text-dim);
      font-size: 8px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .node-subject {
      font-size: 9px;
      color: var(--quake-text-light);
      word-break: break-word;
      line-height: 1.35;
    }

    .node-tags-row {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin-top: 2px;
    }
    .node-badge {
      font-size: 7.5px;
      font-weight: 700;
      padding: 1px 4px;
      border-radius: 2px;
      text-transform: uppercase;
      text-decoration: none;
    }
    .node-badge-branch {
      background: rgba(56, 189, 248, 0.15);
      border: 1px solid var(--quake-cyan);
      color: var(--quake-cyan);
    }
    .node-badge-tag {
      background: rgba(192, 132, 252, 0.15);
      border: 1px solid var(--quake-purple);
      color: var(--quake-purple);
    }
    .node-badge-pr {
      background: rgba(34, 197, 94, 0.15);
      border: 1px solid var(--quake-green);
      color: var(--quake-green);
    }
    .node-badge-bug {
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid var(--quake-red);
      color: var(--quake-red);
      cursor: pointer;
    }
    .node-badge-bug.resolved {
      background: rgba(34, 197, 94, 0.15);
      border-color: var(--quake-green);
      color: var(--quake-green);
    }
    .copy-icon-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: none;
      cursor: pointer;
      padding: 1px 3px;
      margin-left: 3px;
      font-size: 9px;
      color: var(--quake-text-dim);
      opacity: 0.75;
      border-radius: 3px;
      transition: all 0.15s ease;
      line-height: 1;
      vertical-align: middle;
    }
    .copy-icon-btn:hover {
      opacity: 1;
      background: rgba(255, 255, 255, 0.12);
      color: var(--quake-gold);
      transform: scale(1.12);
    }
    .copy-icon-btn:active {
      transform: scale(0.92);
    }
    .copy-sha-btn {
      font-size: 8px;
      padding: 0 2px;
      margin-left: 4px;
    }
    .copy-badge-btn {
      font-size: 7.5px;
      padding: 0 2px;
      margin-left: 2px;
    }
    .smartlog-node.has-pr {
      border-left: 3px solid #a855f7;
      background: linear-gradient(90deg, rgba(168, 85, 247, 0.1) 0%, #160e07 40%);
    }
    .pr-highlight-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 1px 6px;
      background: rgba(168, 85, 247, 0.22);
      border: 1px solid #a855f7;
      border-radius: 3px;
      color: #e9d5ff;
      font-size: 8px;
      font-weight: 700;
      font-family: var(--font-mono);
      text-decoration: none;
      cursor: pointer;
      transition: all 0.15s ease;
      box-shadow: 0 0 6px rgba(168, 85, 247, 0.3);
    }
    .pr-highlight-badge:hover {
      background: rgba(168, 85, 247, 0.4);
      border-color: #d8b4fe;
      color: #ffffff;
      box-shadow: 0 0 10px rgba(168, 85, 247, 0.7);
      transform: translateY(-1px);
    }
    .node-badge-branch.pr-tag-link,
    .node-badge-pr.pr-tag-link {
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .node-badge-branch.pr-tag-link:hover,
    .node-badge-pr.pr-tag-link:hover {
      border-color: #d8b4fe;
      color: #ffffff;
      background: rgba(168, 85, 247, 0.35);
      text-decoration: underline;
      box-shadow: 0 0 8px rgba(168, 85, 247, 0.5);
    }
    .pr-local-badge {
      background: rgba(255, 176, 0, 0.15) !important;
      border: 1px dashed rgba(255, 176, 0, 0.5) !important;
      color: #ffb800 !important;
      box-shadow: none !important;
      cursor: pointer;
    }
    .pr-local-badge:hover {
      background: rgba(255, 176, 0, 0.3) !important;
      border-color: #ffc83b !important;
      color: #fff !important;
    }
    .quake-btn-purple {
      background: rgba(168, 85, 247, 0.2);
      border-color: #a855f7;
      color: #e9d5ff;
    }
    .quake-btn-purple:hover {
      background: rgba(168, 85, 247, 0.4);
      border-color: #c084fc;
      color: #ffffff;
      box-shadow: 0 0 8px rgba(168, 85, 247, 0.6);
    }
    .smartlog-node.merged-commit {
      opacity: 0.75;
    }
    #smartlogList.hide-merged .smartlog-node.merged-commit:not(.head-node):not(.active) {
      display: none !important;
    }
    .node-badge-merged {
      background: rgba(34, 197, 94, 0.2) !important;
      border-color: #22c55e !important;
      color: #86efac !important;
    }

    .node-actions-row {

      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 6px;
      margin-top: 4px;
    }

    /* Working Tree & File list items */
    .file-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 5px 8px;
      background: #140d07;
      border: 1px solid rgba(90, 56, 30, 0.5);
      border-radius: 3px;
      cursor: pointer;
      font-size: 9px;
      gap: 6px;
    }
    .file-item:hover {
      background: #201309;
      border-color: var(--quake-border-light);
    }
    .file-item.active {
      border-color: var(--quake-gold);
      background: #25160b;
      box-shadow: inset 2px 0 0 var(--quake-gold);
    }
    .file-item.agent-feedback {
      opacity: 0.6;
      border-style: dashed;
      background: #110905;
    }

    .file-path {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      flex: 1;
      color: var(--quake-text-light);
    }
    .file-status-badge {
      font-size: 8px;
      font-weight: 700;
      padding: 1px 4px;
      border-radius: 2px;
      flex-shrink: 0;
    }
    .status-m { color: var(--quake-gold); }
    .status-a { color: var(--quake-green); }
    .status-d { color: var(--quake-red); }
    .status-untracked { color: var(--quake-purple); }
    .status-conflict { color: #f87171; background: rgba(239, 68, 68, 0.25); border: 1px solid var(--quake-red); }
    .status-lfs { color: #00e5ff; background: rgba(0, 229, 255, 0.15); border: 1px solid #00e5ff; font-weight: 700; }
    .lfs-file-item { border-left: 2px solid #00e5ff !important; background: rgba(0, 229, 255, 0.04); }
    .lfs-file-item .file-path { color: #38bdf8 !important; }
    .lfs-file-item:hover { background: rgba(0, 229, 255, 0.12) !important; }

    .file-actions {
      display: flex;
      gap: 4px;
      flex-shrink: 0;
    }

    /* Working Tree Commit Card */
    .commit-box {
      background: #1b120a;
      border: 1px solid var(--quake-border-mid);
      border-radius: 3px;
      padding: 8px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 8px;
    }
    .commit-input {
      background: #110a05;
      border: 1px solid var(--quake-border-light);
      color: var(--quake-gold);
      font-family: var(--font-mono);
      font-size: 9px;
      padding: 6px 8px;
      border-radius: 2px;
      outline: none;
      resize: vertical;
      min-height: 48px;
    }
    .commit-input:focus {
      border-color: var(--quake-gold);
      box-shadow: 0 0 6px rgba(255, 184, 0, 0.3);
    }

    /* Collapsible Group */
    .group-section {
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin-bottom: 6px;
    }
    .group-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 8px;
      font-weight: 700;
      color: var(--quake-copper);
      text-transform: uppercase;
      padding: 4px 6px;
      background: rgba(0, 0, 0, 0.25);
      border-radius: 2px;
      cursor: pointer;
      user-select: none;
    }
    .group-header:hover {
      color: var(--quake-gold);
    }
    .group-items {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding-left: 2px;
    }

    /* Toast notification */
    #quakeToast {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: #2a180d;
      border: 2px solid var(--quake-gold);
      color: var(--quake-gold);
      padding: 10px 16px;
      border-radius: 4px;
      font-size: 10px;
      font-weight: 700;
      box-shadow: 0 4px 16px rgba(0,0,0,0.8);
      display: none;
      z-index: 1000;
      animation: fadeIn 0.2s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Quake Modal Dialog */
    .quake-modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(2px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1000;
    }
    .quake-modal {
      background: var(--quake-panel);
      border: 2px solid var(--quake-border-light);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.9), inset 1px 1px 0 var(--quake-border-light);
      border-radius: 4px;
      width: 620px;
      max-width: 90vw;
      max-height: 85vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .quake-modal-header {
      background: var(--quake-header-bg);
      border-bottom: 2px solid var(--quake-border-mid);
      padding: 10px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: var(--quake-gold);
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .quake-modal-body {
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      overflow-y: auto;
      flex: 1;
    }
    .quake-modal-footer {
      background: #140d07;
      border-top: 1px solid var(--quake-border-mid);
      padding: 10px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }
    .modal-files-list {
      max-height: 180px;
      overflow-y: auto;
      border: 1px solid var(--quake-border-mid);
      background: #100a05;
      border-radius: 3px;
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding: 4px;
    }
    .modal-file-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 4px 6px;
      border-radius: 2px;
      background: #180f08;
      font-size: 9px;
      gap: 8px;
    }
    .modal-file-row:hover {
      background: #24160c;
    }

    /* Quake Workstation Modal Dialog (BUG-274) */
    .workstation-modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(2px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 2000;
    }
    .workstation-modal-container {
      background: var(--quake-bg);
      border: 2px solid var(--quake-gold);
      box-shadow: 0 0 30px rgba(0, 0, 0, 0.95), 0 0 15px rgba(255, 184, 0, 0.3);
      border-radius: 4px;
      width: calc(100vw - 36px);
      height: calc(100vh - 36px);
      max-width: calc(100vw - 36px);
      max-height: calc(100vh - 36px);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      position: relative;
    }
    .workstation-modal-iframe {
      width: 100%;
      height: 100%;
      border: none;
      background: transparent;
      display: block;
      flex: 1;
    }
  </style>
</head>
<body>

  <!-- TOP QUAKE HUD -->
  <header class="quake-hud">
    <div class="quake-logo-zone">
      <div class="quake-logo-badge">QUAKE VCS</div>
      <div>
        <div style="font-weight:700;font-size:10px;color:var(--quake-text-light);">{{ session.repo_name }}</div>
        <div class="quake-logo-sub">DIFF VIEWER &amp; SMARTLOG</div>
      </div>
    </div>

    <div class="hud-controls">
      <!-- Sync Button -->
      <button id="btnSync" type="button" class="quake-btn quake-btn-default" data-action="sync-repo">
        <span id="syncSpinner" style="display:none;">⏳</span>
        <span>🔄 Sync</span>
      </button>

      <!-- Rebase Button (BUG-213) -->
      <button id="btnRebase" type="button" class="quake-btn quake-btn-default" data-action="rebase-repo" title="Rebase current branch onto top of ancestor branch (e.g., origin/main)">
        <span id="rebaseSpinner" style="display:none;">⏳</span>
        <span>⤵ Rebase</span>
      </button>

      <!-- Commit & Amend Buttons -->
      <button id="btnCommitModal" type="button" class="quake-btn quake-btn-gold" data-action="open-commit-modal" data-amend="false" title="Commit selected working tree changes">
        <span>+ Commit</span>
      </button>
      <button id="btnAmendModal" type="button" class="quake-btn quake-btn-default" data-action="open-commit-modal" data-amend="true" title="Amend HEAD commit">
        <span>⎇ Amend</span>
      </button>

      <!-- Pane Toggle Controls -->
      <div style="display:flex;align-items:center;gap:4px;border-left:1px solid var(--quake-border-mid);border-right:1px solid var(--quake-border-mid);padding:0 6px;">
        <button id="btnToggleSmartlog" type="button" class="quake-btn quake-btn-default quake-btn-active" data-action="toggle-pane" data-pane="smartlog" title="Toggle Smartlog Pane (Shortcut: [)">
          <span>⎇ Smartlog</span>
        </button>
        <button id="btnToggleFiles" type="button" class="quake-btn quake-btn-default quake-btn-active" data-action="toggle-pane" data-pane="files" title="Toggle Files Pane (Shortcut: ])">
          <span>📄 Files</span>
        </button>
      </div>

      <!-- Branch Selector (BUG-197) -->
      <div style="display:flex;align-items:center;gap:6px;position:relative;">
        <span style="font-size:8px;color:var(--quake-text-dim);">BRANCH:</span>
        <button id="btnBranchDropdown" type="button" class="quake-btn quake-btn-default" data-action="open-branch-modal" title="Browse, search, and switch branches">
          <span>🌿 {{ session.current_branch or session.active_branch }}</span>
          <span style="font-size:7px;color:var(--quake-gold);">▼</span>
        </button>
        <button id="btnCopyCurrentBranch" type="button" class="copy-icon-btn copy-branch-btn" data-action="copy-current-branch" title="Copy current branch name">📋</button>
        <select id="branchSelect" class="quake-select" style="display:none;">
          <optgroup label="⭐ Main &amp; Release Branches">
            {% for b in session.branches if b.is_release_branch_candidate %}
              <option value="{{ b.name }}" {% if b.is_current %}selected{% endif %}>
                ⭐ {{ b.name }}{% if b.is_current %} (current){% endif %}
              </option>
            {% endfor %}
          </optgroup>
          <optgroup label="🌿 Feature &amp; PR Branches">
            {% for b in session.branches if not b.is_release_branch_candidate %}
              <option value="{{ b.name }}" {% if b.is_current %}selected{% endif %}>
                🌿 {{ b.name }}{% if b.is_current %} (current){% endif %}
              </option>
            {% endfor %}
          </optgroup>
        </select>
      </div>

      <!-- Goto Commit -->
      <button type="button" class="quake-btn quake-btn-default" data-action="goto-commit">
        <span>🎯 Goto...</span>
      </button>

      <!-- Inter-Tool Links -->
      <button type="button" class="quake-btn quake-btn-default" data-action="open-code-review" title="Open Code Review">
        <span>🔍 Code Review</span>
      </button>
      <button type="button" class="quake-btn quake-btn-default" data-action="open-issue-tracker" title="Open Bug Report Tool">
        <span>🐞 Bug Tracker</span>
      </button>

      <!-- UI Scale Selector (8715cab2) -->
      <div style="display:flex;align-items:center;gap:4px;border-left:1px solid var(--quake-border-mid);padding-left:6px;">
        <span style="font-size:8px;color:var(--quake-text-dim);">SCALE:</span>
        <select id="uiScaleSelect" class="quake-select" title="UI Scale (Shortcuts: Cmd/Ctrl +/- or 0 to reset)" style="padding: 2px 4px; font-size: 8.5px; height: 22px;">
          <option value="75%">75%</option>
          <option value="80%">80%</option>
          <option value="90%">90%</option>
          <option value="100%" selected>100%</option>
          <option value="110%">110%</option>
          <option value="125%">125%</option>
          <option value="150%">150%</option>
        </select>
      </div>
    </div>
  </header>

  <!-- WORKSPACE 3-COLUMN -->
  <main class="app-workspace">

    <!-- LEFT COLUMN: SMARTLOG ANCESTOR TREE DAG -->
    <section id="paneSmartlog" class="quake-card column-panel pane-smartlog">
      <div class="column-header">
        <span>Smartlog Tree (sl)</span>
        <div style="display:flex;gap:4px;align-items:center;flex-shrink:0;white-space:nowrap;">
          <button id="btnOpenCR" type="button" class="quake-btn quake-btn-gold quake-btn-icon" data-action="open-code-review" title="Review selected commit(s) in Code Review">
            <span>🔍 <span id="selectedCount">0</span></span>
          </button>
          <button id="btnCreatePR" type="button" class="quake-btn quake-btn-purple quake-btn-sm" data-action="create-pr" title="Create Pull Request for selected commit(s)">
            <span>🚀 Create PR</span>
          </button>
          <button id="btnUnlinkPR" type="button" class="quake-btn quake-btn-default quake-btn-sm" data-action="unlink-pr" title="Unlink Pull Request from selected commit(s)">
            <span>✕ Unlink PR</span>
          </button>
          <button id="btnToggleMerged" type="button" class="quake-btn quake-btn-default quake-btn-sm" data-action="toggle-merged" title="Toggle visibility of merged commits in Smartlog">
            <span id="mergedToggleIcon">👁️</span> <span id="mergedToggleLabel">Show Merged</span>
          </button>
          <button type="button" class="quake-btn quake-btn-default quake-btn-icon" data-action="toggle-pane" data-pane="smartlog" title="Collapse Smartlog Pane (Shortcut: [)">◀</button>
        </div>
      </div>

      <!-- Commit Manipulation Toolbar (BUG-228: Select All, Select None) -->
      <div class="commit-toolbar">
        <div>
          <button id="btnSelectAll" type="button" class="quake-btn quake-btn-default quake-btn-sm" data-action="select-all-commits" title="Select all commits in stack">
            <span>Select All</span>
          </button>
          <button id="btnSelectNone" type="button" class="quake-btn quake-btn-default quake-btn-sm" data-action="select-none-commits" title="Deselect all commits">
            <span>Select None</span>
          </button>
        </div>
        <div>
          <button type="button" class="quake-btn quake-btn-default quake-btn-icon" data-action="split-commit" title="Split commit (reset HEAD~1 to working tree)">
            <span>✂️</span>
          </button>
          <button type="button" class="quake-btn quake-btn-default quake-btn-icon" data-action="combine-commits" title="Combine/squash selected commits">
            <span>🔗</span>
          </button>
        </div>
      </div>

      <div class="column-scroll hide-merged" id="smartlogList">
        <!-- Working Tree Node -->
        <div class="smartlog-node {% if session.active_commit == 'working' %}active{% endif %}" id="node-working" data-hash="working">
          <div class="node-header-row">
            <span class="node-graph-art">@</span>
            <span class="node-sha" style="color:var(--quake-cyan);">WORKING TREE</span>
            <span class="node-author-date">Uncommitted</span>
          </div>
          <div class="node-subject">Local working tree changes &amp; staging area</div>
        </div>

        <!-- Render Commit Nodes -->
        {% for node in session.smartlog_nodes %}
          <div class="smartlog-node {% if node.is_head %}head-node{% endif %} {% if node.is_ancestor_top %}ancestor-top-node{% endif %} {% if node.pr_number %}has-pr{% endif %} {% if session.active_commit == node.commit_hash %}active{% endif %} {% if node.is_merged_into_tracking or node.is_merged %}merged-commit{% endif %} {% if node.commit_hash in session.selected_commits %}selected{% endif %}"
               id="node-{{ node.short_hash }}"
               data-hash="{{ node.commit_hash }}">
            <div class="node-header-row">
              <div style="display:flex;align-items:center;gap:6px;">
                <input type="checkbox"
                       class="commit-checkbox"
                       value="{{ node.commit_hash }}"
                       {% if node.commit_hash in session.selected_commits %}checked{% endif %}/>
                <span class="node-graph-art">{{ node.graph_art or node.graph_symbol }}</span>
                <span class="node-sha">{{ node.short_hash }}</span>
                <button type="button" class="copy-icon-btn copy-sha-btn" data-action="copy-text" data-copy-value="{{ node.commit_hash }}" title="Copy commit hash {{ node.commit_hash }}">📋</button>
                {% if node.pr_number and node.pr_url %}
                  <a href="{{ node.pr_url }}"
                     target="_blank"
                     rel="noopener noreferrer"
                     class="pr-highlight-badge"
                     data-action="external-pr-link"
                     title="Pull Request #{{ node.pr_number }} (Click to open in GitHub)">
                    <span class="pr-icon">⎇</span> {{ node.pr_status or ('PR #' ~ node.pr_number) }}
                  </a>
                {% elif node.pr_number %}
                  <span class="pr-highlight-badge pr-local-badge"
                        data-action="local-pr-toast"
                        data-toast-message="{{ node.pr_status or ('PR #' ~ node.pr_number) }} has not been created on GitHub yet"
                        title="{{ node.pr_status or ('PR #' ~ node.pr_number) }} (Local branch, not submitted to GitHub)">
                    <span class="pr-icon">⎇</span> {{ node.pr_status or ('PR #' ~ node.pr_number) }}
                  </span>
                {% endif %}
              </div>
              <span class="node-author-date">{{ node.relative_date or node.date }}</span>
            </div>

            <div class="node-subject">{{ node.subject }}</div>

            <!-- Tags Row (Branches, Tags, PR, Bugs) -->
            <div class="node-tags-row">
              {% if node.is_merged_into_tracking or node.is_merged %}
                <span class="node-badge node-badge-merged" title="Already merged into tracking branch">✓ Merged</span>
              {% endif %}
              {% if node.is_ancestor_top %}
                <span class="node-badge node-badge-ancestor" title="Top of ancestor branch ({{ node.ancestor_name or 'main' }})">📌 {{ node.ancestor_name or 'main' }}</span>
              {% endif %}
              {% set repo_web_base = session.repo_web_url or ('https://github.com/' ~ (session.github_repo or ('workspace/' ~ session.repo_name))) %}
              {% for br in node.branches %}
                {% set is_pr_br = ('pr' in br.lower() or 'pull' in br.lower()) %}
                {% set br_url = node.pr_url if (is_pr_br and node.pr_url) else (repo_web_base ~ '/tree/' ~ br.replace('origin/', '')) %}
                <span style="display:inline-flex;align-items:center;">
                  <a href="{{ br_url }}"
                     target="_blank"
                     rel="noopener noreferrer"
                     class="node-badge node-badge-branch {% if is_pr_br and node.pr_url %}pr-tag-link{% elif is_pr_br %}pr-local-badge{% endif %}"
                     data-action="branch-badge"
                     data-branch="{{ br }}"
                     data-pr-url="{{ node.pr_url or '' }}"
                     title="{% if is_pr_br and node.pr_url %}Open PR in GitHub{% elif is_pr_br %}Local branch {{ br }} (not on GitHub){% else %}View branch {{ br }} on GitHub{% endif %}">
                    ⎇ {{ br }}
                  </a>
                  <button type="button" class="copy-icon-btn copy-badge-btn" data-action="copy-text" data-copy-value="{{ br }}" title="Copy branch {{ br }}">📋</button>
                </span>
              {% endfor %}
              {% for tag in node.tags %}
                {% set is_pr_tag = ('pr' in tag.lower() or 'pull' in tag.lower()) %}
                {% set tag_url = node.pr_url if (is_pr_tag and node.pr_url) else (repo_web_base ~ '/releases/tag/' ~ tag) %}
                <a href="{{ tag_url }}"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="node-badge node-badge-tag {% if is_pr_tag and node.pr_url %}pr-tag-link{% elif is_pr_tag %}pr-local-badge{% endif %}"
                   data-action="branch-badge"
                   data-branch="{{ tag }}"
                   data-pr-url="{{ node.pr_url or '' }}"
                   title="{% if is_pr_tag and node.pr_url %}Open PR in GitHub{% elif is_pr_tag %}Local tag {{ tag }}{% else %}View tag {{ tag }} on GitHub{% endif %}">
                  🏷 {{ tag }}
                </a>
              {% endfor %}
              {% if node.pr_status and node.pr_url %}
                <a href="{{ node.pr_url }}"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="node-badge node-badge-pr pr-tag-link"
                   data-action="external-pr-link"
                   title="Open PR on GitHub">
                  ⎇ {{ node.pr_status }}
                </a>
              {% elif node.pr_status %}
                <span class="node-badge node-badge-pr pr-local-badge"
                      data-action="local-pr-toast"
                      data-toast-message="{{ node.pr_status }} has not been created on GitHub yet"
                      title="{{ node.pr_status }} (Not yet created on GitHub)">
                  ⎇ {{ node.pr_status }}
                </span>
              {% endif %}
              {% for bug in node.bug_tags %}
                <span style="display:inline-flex;align-items:center;">
                  <span class="node-badge node-badge-bug {% if bug.status == 'RESOLVED' %}resolved{% endif %}"
                        data-action="open-issue"
                        data-issue-id="{{ bug.id }}"
                        title="{{ bug.title }} (Click to open in Bug Viewer)">
                    {{ bug.id }}: {{ bug.status }}
                  </span>
                  <button type="button" class="copy-icon-btn copy-badge-btn" data-action="copy-text" data-copy-value="{{ bug.id }}" title="Copy {{ bug.id }}">📋</button>
                </span>
              {% endfor %}
            </div>

            <!-- Actions Row (BUG-199) -->
            <div class="node-actions-row">
              <button type="button"
                      class="quake-btn quake-btn-default quake-btn-icon jump-cr-btn {% if node.cr_reviewed %}cr-reviewed{% endif %}"
                      data-action="jump-cr"
                      data-commit="{{ node.commit_hash }}"
                      title="Jump to Code Review for this commit ({% if node.cr_open_count is defined %}{{ node.cr_open_count }} open / {{ node.cr_resolved_count }} resolved{% else %}0 open / 0 resolved{% endif %})">
                <span>🔍 CR</span>
                {% if node.cr_total_count and node.cr_total_count > 0 %}
                  <span class="cr-badge {% if node.cr_open_count > 0 %}cr-open{% else %}cr-resolved{% endif %}">
                    {{ node.cr_open_count }}/{{ node.cr_total_count }}
                  </span>
                {% endif %}
              </button>
              <button type="button"
                      class="quake-btn quake-btn-default quake-btn-icon"
                      data-action="create-issue"
                      data-commit="{{ node.commit_hash }}"
                      title="Create bug referencing this commit">
                <span>🐞+</span>
              </button>
            </div>
          </div>
        {% endfor %}
      </div>
    </section>

    <!-- Resizer between Smartlog and Files (BUG-196) -->
    <div class="column-resizer" id="resizerSmartlog" title="Drag to resize Smartlog panel"></div>

    <!-- MIDDLE COLUMN: CHANGED FILES & WORKING TREE OPERATIONS -->
    <section id="paneFiles" class="quake-card column-panel pane-files">
      <div class="column-header">
        <div style="display:flex;align-items:center;gap:6px;">
          <span id="filesHeaderTitle">{% if not session.active_commit or session.active_commit == 'working' %}Working Tree Files{% else %}Files ({{ session.active_commit[:7] }}){% endif %}</span>
          <span id="filesCountBadge" style="color:var(--quake-text-muted);">0 files</span>
        </div>
        <button type="button" class="quake-btn quake-btn-default quake-btn-icon" data-action="toggle-pane" data-pane="files" title="Collapse Files Pane (Shortcut: ])">◀</button>
      </div>

      <!-- Working Tree Commit Area (Only visible when active commit is 'working') -->
      <div id="workingTreeCommitArea" class="commit-box" style="margin:8px; display:{% if not session.active_commit or session.active_commit == 'working' %}flex{% else %}none{% endif %};">
        <div style="display:flex;align-items:center;justify-content:space-between;">
          <span style="font-size:8px;font-weight:700;color:var(--quake-copper);text-transform:uppercase;">Working Tree Actions</span>
          <div style="display:flex;gap:4px;">
            <button type="button" class="quake-btn quake-btn-gold quake-btn-sm" data-action="open-commit-modal" data-amend="false">+ Commit</button>
            <button type="button" class="quake-btn quake-btn-default quake-btn-sm" data-action="open-commit-modal" data-amend="true">⎇ Amend</button>
          </div>
        </div>
        <textarea id="commitMessageInput" class="commit-input" placeholder="feat/fix: quick commit description..."></textarea>
        <div style="display:flex;gap:6px;justify-content:space-between;">
          <button type="button" class="quake-btn quake-btn-red quake-btn-sm" data-action="discard-working-selected" title="Discard selected uncommitted files">
            <span>🗑 Discard</span>
          </button>
          <button type="button" class="quake-btn quake-btn-gold quake-btn-sm" data-action="quick-commit-staged" style="justify-content:center;">
            <span>✓ Quick Commit Staged</span>
          </button>
        </div>
      </div>

      <div class="column-scroll" id="filesContainer">
        <!-- Rendered dynamically by JavaScript -->
      </div>
    </section>

    <!-- Resizer between Files and Diff (BUG-196) -->
    <div class="column-resizer" id="resizerFiles" title="Drag to resize Files panel"></div>

    <!-- RIGHT COLUMN: DIFF WORKSTATION -->
    <section id="paneDiff" class="quake-card column-panel pane-diff">
      <!-- Toolbar -->
      <div class="diff-toolbar">
        <div class="diff-file-title" id="diffFileTitle" style="display:flex;align-items:center;gap:8px;">
          <span id="diffFileTitleText">Select a file to inspect diff</span>
          <div id="diffFileActions" style="display:none;align-items:center;gap:6px;">
            <button type="button" class="quake-btn quake-btn-default quake-btn-xs" data-action="copy-active-file" title="Copy file path">📋</button>
            <a id="btnOpenVsCode" class="quake-btn quake-btn-default quake-btn-xs" data-action="open-vscode" title="Open in VS Code" style="text-decoration:none;cursor:pointer;">💻</a>
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:10px;">
          <div class="diff-stats-badge" id="diffStatsBadge" style="display:none;">
            <span class="diff-stats-add" id="diffStatsAdd">+0</span>
            <span>/</span>
            <span class="diff-stats-del" id="diffStatsDel">-0</span>
          </div>
          <div class="diff-mode-controls">
            <button id="btnModeSbs" type="button" class="quake-btn quake-btn-gold quake-btn-sm" data-action="set-diff-mode" data-mode="side_by_side">Side-by-Side</button>
            <button id="btnModeUnified" type="button" class="quake-btn quake-btn-default quake-btn-sm" data-action="set-diff-mode" data-mode="unified">Unified</button>
            <button id="btnToggleWrap" type="button" class="quake-btn quake-btn-default quake-btn-sm" data-action="toggle-word-wrap" title="Toggle Word Wrap (Shortcut: W)">Wrap: Off</button>
            <button type="button" class="quake-btn quake-btn-default quake-btn-sm" data-action="copy-diff-snippet" title="Copy active diff snippet">📋 Copy</button>
          </div>
        </div>
      </div>

      <!-- Diff Content Area -->
      <div class="diff-scroll-body" id="diffBodyContainer">
        <div class="diff-empty-state">
          <div style="font-size:19px;">⌨</div>
          <div>Choose a commit and file to inspect diff hunks</div>
        </div>
      </div>
    </section>

  </main>

  <!-- INITIAL SQLITE SYNC MODAL LOADING SCREEN (BUG-188) -->
  <div id="syncModalOverlay" class="quake-modal-overlay" style="{% if not session.initial_sync_done %}display: flex;{% else %}display: none;{% endif %} z-index: 2000;">
    <div class="quake-modal" style="width: 480px; text-align: center; padding: 24px 20px;">
      <div style="font-size: 12px; font-weight: bold; color: var(--quake-gold); letter-spacing: 1px; margin-bottom: 8px; display: flex; align-items: center; justify-content: center; gap: 8px;">
        <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#ffaa00;box-shadow:0 0 8px #ffaa00;"></span>
        <span>SYNCHRONIZING FEEDBACK DATABASES</span>
      </div>
      <div style="font-size: 10px; color: var(--quake-text-muted); margin-bottom: 18px; line-height: 1.4;">
        Populating SQLite databases from committed feedback files prior to launching VCS workstation...
      </div>
      <div style="background: var(--quake-bg-dark); border: 1px solid var(--quake-border-light); border-radius: 3px; height: 16px; position: relative; overflow: hidden; margin-bottom: 12px; box-shadow: inset 0 1px 3px rgba(0,0,0,0.6);">
        <div id="syncProgressBar" style="width: 20%; height: 100%; background: linear-gradient(90deg, #ffaa00, #ff8800); transition: width 0.3s ease; box-shadow: 0 0 10px rgba(255,170,0,0.5);"></div>
        <div id="syncProgressPercent" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; font-size: 7.5px; font-weight: bold; color: #fff; text-shadow: 0 1px 2px #000;">20%</div>
      </div>
      <div id="syncStatusText" style="font-size: 9px; color: var(--quake-text-dim); font-family: monospace; min-height: 16px;">
        Scanning feedback/ directory for bug reports and review comments...
      </div>
    </div>
  </div>

  <!-- PR SUBMIT PROGRESS MODAL (BUG-229) -->
  <div id="prSubmitModalOverlay" class="quake-modal-overlay" style="display: none; z-index: 2000;">
    <div class="quake-modal" style="width: 580px; max-width: 90vw; padding: 20px 24px;">
      <div class="quake-modal-header" style="padding: 0 0 12px 0; margin-bottom: 12px; border-bottom: 1px solid var(--quake-border-mid);">
        <div style="font-size: 11px; font-weight: bold; color: var(--quake-gold); letter-spacing: 1px; display: flex; align-items: center; gap: 8px;">
          <span>🚀</span>
          <span id="prSubmitModalTitle">SUBMITTING PULL REQUESTS TO GITHUB</span>
        </div>
        <button id="btnPrSubmitClose" type="button" class="quake-btn quake-btn-default quake-btn-icon" data-action="close-pr-modal" style="display: none;" title="Close">✕</button>
      </div>

      <div style="font-size: 9px; color: var(--quake-text-muted); margin-bottom: 12px; line-height: 1.4;" id="prSubmitDescription">
        Executing pull request submission and synchronizing remote review branches...
      </div>

      <!-- Progress bar -->
      <div style="background: var(--quake-bg-dark); border: 1px solid var(--quake-border-light); border-radius: 3px; height: 18px; position: relative; overflow: hidden; margin-bottom: 12px; box-shadow: inset 0 1px 3px rgba(0,0,0,0.6);">
        <div id="prSubmitProgressBar" style="width: 15%; height: 100%; background: linear-gradient(90deg, #9333ea, #a855f7); transition: width 0.3s ease; box-shadow: 0 0 10px rgba(168,85,247,0.5);"></div>
        <div id="prSubmitProgressPercent" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; font-size: 8px; font-weight: bold; color: #fff; text-shadow: 0 1px 2px #000;">15%</div>
      </div>

      <div id="prSubmitStatusText" style="font-size: 9px; color: var(--quake-copper); font-family: var(--font-mono); margin-bottom: 10px; font-weight: bold;">
        Initializing submission...
      </div>

      <!-- Terminal Log Output Area -->
      <div id="prSubmitLogOutput" style="background: #0d0703; border: 1px solid var(--quake-border-dark); border-radius: 3px; padding: 10px; max-height: 180px; overflow-y: auto; font-family: var(--font-mono); font-size: 9px; color: #d6c6b2; line-height: 1.5; white-space: pre-wrap; word-break: break-all;">
      </div>

      <div class="quake-modal-footer" style="padding: 12px 0 0 0; margin-top: 14px; border-top: 1px solid var(--quake-border-mid); justify-content: flex-end;">
        <button id="btnPrSubmitDone" type="button" class="quake-btn quake-btn-gold quake-btn-sm" data-action="finish-pr-modal" style="display: none;">
          ✓ Done
        </button>
      </div>
    </div>
  </div>

  <!-- ACTION PROGRESS MODAL (BUG-327) -->
  <div id="actionProgressModalOverlay" class="quake-modal-overlay" style="display: none; z-index: 2000;">
    <div class="quake-modal" style="width: 480px; max-width: 90vw; padding: 20px 24px; text-align: left;">
      <div class="quake-modal-header" style="padding: 0 0 12px 0; margin-bottom: 12px; border-bottom: 1px solid var(--quake-border-mid); background: transparent;">
        <div style="font-size: 11px; font-weight: bold; color: var(--quake-gold); letter-spacing: 1px; display: flex; align-items: center; gap: 8px;">
          <span id="actionProgressIcon">⚡</span>
          <span id="actionProgressTitle">PROCESSING ACTION</span>
        </div>
      </div>

      <div style="font-size: 9px; color: var(--quake-text-muted); margin-bottom: 12px; line-height: 1.4;" id="actionProgressDescription">
        Executing requested operation...
      </div>

      <!-- Progress bar -->
      <div style="background: var(--quake-bg-dark); border: 1px solid var(--quake-border-light); border-radius: 3px; height: 16px; position: relative; overflow: hidden; margin-bottom: 12px; box-shadow: inset 0 1px 3px rgba(0,0,0,0.6);">
        <div id="actionProgressBar" style="width: 15%; height: 100%; background: linear-gradient(90deg, #ffaa00, #ff8800); transition: width 0.3s ease; box-shadow: 0 0 10px rgba(255,170,0,0.5);"></div>
        <div id="actionProgressPercent" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; font-size: 8px; font-weight: bold; color: #fff; text-shadow: 0 1px 2px #000;">15%</div>
      </div>

      <div style="display: flex; justify-content: space-between; align-items: center; font-size: 9px; color: var(--quake-copper); font-family: var(--font-mono); font-weight: bold;">
        <span id="actionProgressStatus">Working...</span>
        <span id="actionProgressElapsed" style="color: var(--quake-text-dim);">0.0s</span>
      </div>
    </div>
  </div>

  <!-- COMMIT / AMEND MODAL (BUG-185) -->
  <div id="commitModalOverlay" class="quake-modal-overlay">
    <div class="quake-modal">
      <div class="quake-modal-header">
        <span id="commitModalTitle">Commit Changes</span>
        <button type="button" class="quake-btn quake-btn-default quake-btn-icon" data-action="close-commit-modal" title="Close">✕</button>
      </div>
      <div class="quake-modal-body">
        <div>
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
            <span style="font-size:9px;font-weight:700;color:var(--quake-copper);text-transform:uppercase;">Select files to commit/amend:</span>
            <label style="font-size:8px;color:var(--quake-text-muted);display:flex;align-items:center;gap:4px;cursor:pointer;">
              <input type="checkbox" id="modalSelectAll" checked>
              <span>Select All</span>
            </label>
          </div>
          <div class="modal-files-list" id="modalFilesList">
            <!-- Populated dynamically with checkboxes, status badges, paths, and discard buttons -->
          </div>
        </div>

        <div>
          <label style="font-size:9px;font-weight:700;color:var(--quake-copper);text-transform:uppercase;display:block;margin-bottom:6px;">Commit Message:</label>
          <textarea id="modalCommitMessage" class="commit-input" style="min-height:90px;" placeholder="feat/fix: commit description..."></textarea>
        </div>
      </div>
      <div class="quake-modal-footer">
        <button type="button" class="quake-btn quake-btn-red quake-btn-sm" data-action="discard-modal-selected" title="Discard changes in selected files">
          <span>🗑 Discard Selected</span>
        </button>
        <div style="display:flex;gap:8px;">
          <button type="button" class="quake-btn quake-btn-default" data-action="close-commit-modal">Cancel</button>
          <button id="btnSubmitModalCommit" type="button" class="quake-btn quake-btn-gold" data-action="submit-commit-modal">
            <span>✓ Commit</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- BRANCH PICKER MODAL (BUG-197) -->
  <div id="modalBranchPicker" class="quake-modal-overlay">
    <div class="quake-modal" style="width: 580px;">
      <div class="quake-modal-header">
        <span>🌿 Git Branches</span>
        <button type="button" class="quake-btn quake-btn-default quake-btn-icon" data-action="close-branch-modal" title="Close">✕</button>
      </div>
      <div class="quake-modal-body" style="gap: 12px;">
        <div style="display:flex;gap:8px;align-items:center;">
          <input type="text" id="branchSearchInput" class="commit-input" style="flex:1;min-height:32px;padding:6px 10px;" placeholder="Search PR and feature branches..." />
          <label style="display:flex;align-items:center;gap:4px;font-size:9px;color:var(--quake-text-muted);cursor:pointer;white-space:nowrap;user-select:none;">
            <input type="checkbox" id="chkHideOtherUsers" checked />
            <span>Hide other users</span>
          </label>
        </div>

        <div style="font-size:9px;font-weight:700;color:var(--quake-gold);text-transform:uppercase;letter-spacing:0.05em;display:flex;align-items:center;gap:6px;">
          <span>⭐ Main &amp; Release Branches</span>
        </div>
        <div id="mainReleaseBranchList" class="branch-group-list">
          <!-- Populated dynamically with main, release branches with special formatting -->
        </div>

        <div style="font-size:9px;font-weight:700;color:var(--quake-copper);text-transform:uppercase;letter-spacing:0.05em;display:flex;align-items:center;justify-content:space-between;margin-top:4px;">
          <span>🌿 Feature &amp; PR Branches</span>
          <span id="featureBranchCount" style="font-size:8px;color:var(--quake-text-dim);"></span>
        </div>
        <div id="featureBranchList" class="branch-group-list" style="max-height: 260px; overflow-y: auto;">
          <!-- Populated dynamically with feature/PR branches -->
        </div>
      </div>
      <div class="quake-modal-footer">
        <span style="font-size:8px;color:var(--quake-text-dim);">Current user: {{ session.current_user or 'User' }}</span>
        <button type="button" class="quake-btn quake-btn-default" data-action="close-branch-modal">Close</button>
      </div>
    </div>
  </div>

  <!-- WORKSTATION MODAL WINDOW (Code Review & Bug Report) (BUG-274) -->
  <div id="workstationModal" class="workstation-modal-overlay">
    <div class="workstation-modal-container">
      <iframe id="workstationIframe" class="workstation-modal-iframe" src="about:blank" title="Workstation"></iframe>
    </div>
  </div>

  <div id="quakeToast"></div>

  {# Include Shared Diff Component Styling #}
  {% include "diff_component.html.j2" %}

  <script id="app-boot-config" type="application/json">
  {
    "repoName": {{ (session.repo_name or 'hardware') | tojson }},
    "repoRoot": {{ (session.repo_root or '') | tojson }},
    "repoWebUrl": {{ (session.repo_web_url or '') | tojson }},
    "githubRepo": {{ (session.github_repo or '') | tojson }},
    "activeCommit": {{ (session.active_commit or 'working') | tojson }},
    "selectedCommits": {{ (session.selected_commits or []) | tojson }},
    "currentBranch": {{ (session.current_branch or session.active_branch or '') | tojson }},
    "currentUser": {{ (session.current_user or 'User') | tojson }},
    "initialSyncDone": {{ session.initial_sync_done | tojson }},
    "authorBlacklist": {{ (session.author_blacklist if session and session.author_blacklist is defined else []) | tojson }},
    "issueKind": "bug",
    "trackerRoute": "/bugs",
    "issueLabel": "BUG",
    "branches": [
      {% for b in session.branches %}
      {
        "name": {{ b.name | tojson }},
        "is_current": {{ (true if b.is_current else false) | tojson }},
        "is_remote": {{ (true if b.is_remote else false) | tojson }},
        "is_main": {{ (true if (b.name in ['main', 'master', 'heads/main', 'origin/main', 'origin/master', 'remotes/origin/main', 'remotes/origin/master'] or b.name.endswith('/main') or b.name.endswith('/master')) else false) | tojson }},
        "is_release": {{ (true if b.is_release_branch_candidate else false) | tojson }}
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  <script type="module" src="/js/vcs/diff_view_app.js"></script>
  <div class="window-resize-gripper" title="Resize Window" aria-label="Resize Window"></div>
</body>
</html>
