    function onBranchBadgeClick(e, branchName, prUrl) {
      if (e) e.stopPropagation();
      if (prUrl) {
        window.open(prUrl, "_blank");
        return;
      }
      const match = branchName.match(/(?:^|\/)(?:pr|pull)[/-]?(\d+)\b/i);
      const isRemote = branchName.startsWith("origin/") || branchName.startsWith("remotes/");
      if (match && isRemote) {
        window.open(`https://github.com/picklethecat1488-hue/hardware/pull/${match[1]}`, "_blank");
        return;
      }
      if (isRemote) {
        const cleaned = branchName.replace(/^(?:remotes\/)?origin\//i, "");
        window.open(`https://github.com/picklethecat1488-hue/hardware/tree/${cleaned}`, "_blank");
      } else if (match) {
        showToast(`PR #${match[1]} (branch "${branchName}") has not been created on GitHub yet.`);
      } else {
        showToast(`Branch "${branchName}" is local only and has not been pushed to GitHub.`);
      }
    }

    async function onCreatePR() {
      if (!state.selectedCommits || state.selectedCommits.length === 0) {
        alert("Please select one or more commits using the checkboxes to create a PR.");
        return;
      }

      showToast(`Creating PR for ${state.selectedCommits.length} commit(s)...`);
      try {
        const resp = await fetch("/api/pr/create", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ commits: state.selectedCommits })
        });
        const res = await resp.json();
        if (res.status === "ok") {
          showToast(`✓ Created ${res.created.length} PR(s) successfully!`);
          setTimeout(() => location.reload(), 600);
        } else {
          alert(`Error creating PR: ${res.error}`);
        }
      } catch (err) {
        alert(`Error communicating with server: ${err}`);
      }
    }

    async function onUnlinkPR() {
      if (!state.selectedCommits || state.selectedCommits.length === 0) {
        alert("Please select one or more commits using the checkboxes to unlink PR.");
        return;
      }

      if (!confirm(`Are you sure you want to unlink PRs from ${state.selectedCommits.length} selected commit(s)?`)) {
        return;
      }

      showToast(`Unlinking PR from ${state.selectedCommits.length} commit(s)...`);
      try {
        const resp = await fetch("/api/pr/unlink", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ commits: state.selectedCommits })
        });
        const res = await resp.json();
        if (res.status === "ok") {
          showToast(`✓ Unlinked ${res.unlinked.length} PR(s) successfully!`);
          setTimeout(() => location.reload(), 600);
        } else {
          alert(`Error unlinking PR: ${res.error}`);
        }
      } catch (err) {
        alert(`Error communicating with server: ${err}`);
      }
    }




    // Toggle merged commits visibility (BUG-218)
    function isHideMergedEnabled() {
      const stored = localStorage.getItem("diffview_hide_merged");
      return stored === null ? true : stored === "true";
    }

    function updateMergedVisibility() {
      const hideMerged = isHideMergedEnabled();
      const listEl = document.getElementById("smartlogList");
      const iconEl = document.getElementById("mergedToggleIcon");
      const labelEl = document.getElementById("mergedToggleLabel");
      if (listEl) {
        if (hideMerged) {
          listEl.classList.add("hide-merged");
        } else {
          listEl.classList.remove("hide-merged");
        }
      }
      if (iconEl) iconEl.textContent = hideMerged ? "👁️" : "🙈";
      if (labelEl) labelEl.textContent = hideMerged ? "Show Merged" : "Hide Merged";
    }

    function toggleMergedCommits() {
      const nextState = !isHideMergedEnabled();
      localStorage.setItem("diffview_hide_merged", nextState ? "true" : "false");
      updateMergedVisibility();
    }

    // Keyboard shortcuts for pane toggling
    document.addEventListener("keydown", (e) => {
      if (["INPUT", "TEXTAREA", "SELECT"].includes(document.activeElement?.tagName)) return;
      if (e.key === "[") {
        togglePane("smartlog");
      } else if (e.key === "]") {
        togglePane("files");
      }
    });

    // Initialize on load
    window.addEventListener("DOMContentLoaded", () => {
      initPanelResizers();
      updateMergedVisibility();
      if (!INITIAL_SYNC_DONE) {
        performInitialSync(false);
      }
      updateSelectedCount();
      loadFilesForActiveCommit();
    });
  </script>
</body>
</html>
