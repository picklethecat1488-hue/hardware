    // Multi-commit selection & Cross-tool Interactivity (Shift-Click, BUG-203)
    let lastCheckedCommitIndex = -1;

    function onCommitCheckChanged(event, checkbox) {
      const allCheckboxes = Array.from(document.querySelectorAll(".commit-checkbox"));
      const currentIndex = checkbox ? allCheckboxes.indexOf(checkbox) : -1;

      if (event && event.shiftKey && lastCheckedCommitIndex !== -1 && currentIndex !== -1) {
        const start = Math.min(lastCheckedCommitIndex, currentIndex);
        const end = Math.max(lastCheckedCommitIndex, currentIndex);
        const targetState = checkbox.checked;
        for (let i = start; i <= end; i++) {
          allCheckboxes[i].checked = targetState;
        }
      }

      if (checkbox) {
        lastCheckedCommitIndex = currentIndex;
      }

      const checkboxes = document.querySelectorAll(".commit-checkbox:checked");
      state.selectedCommits = Array.from(checkboxes).map(cb => cb.value);
      updateSelectedCount();
    }

    function updateSelectedCount() {
      const countEl = document.getElementById("selectedCount");
      if (countEl) countEl.textContent = state.selectedCommits.length;
