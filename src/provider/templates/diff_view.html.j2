    function renderBranchLists() {
      const search = (document.getElementById("branchSearchInput")?.value || "").trim().toLowerCase();
      const hideOtherUsers = document.getElementById("chkHideOtherUsers")?.checked ?? true;
      const currentUser = "{{ session.current_user or 'picklethecat1488-hue' }}".toLowerCase();

      const mainContainer = document.getElementById("mainReleaseBranchList");
      const featContainer = document.getElementById("featureBranchList");
      const countEl = document.getElementById("featureBranchCount");
      if (!mainContainer || !featContainer) return;

      mainContainer.innerHTML = "";
      featContainer.innerHTML = "";

      const mainReleaseBranches = [];
      const featureBranches = [];

      for (const b of branchData) {
        if (b.is_main || b.is_release) {
          mainReleaseBranches.push(b);
        } else {
          const lowerName = b.name.toLowerCase();
          if (hideOtherUsers) {
            const ghMatch = lowerName.match(/(?:remotes\/origin\/)?gh\/([^/]+)\//);
            if (ghMatch && ghMatch[1] !== currentUser) {
              continue;
            }
          }
          if (search && !lowerName.includes(search)) {
            continue;
          }
          featureBranches.push(b);
        }
      }

      mainReleaseBranches.forEach(b => {
        const item = document.createElement("div");
        item.className = "branch-item branch-item-main" + (b.is_current ? " active" : "");
        item.onclick = () => { closeBranchModal(); onBranchSelected(b.name); };
        item.innerHTML = `
          <div style="display:flex;align-items:center;gap:6px;">
            <span style="color:var(--quake-gold);">${b.is_main ? '⭐' : '🏷️'}</span>
            <span>${b.name}</span>
            ${b.is_current ? '<span class="node-badge node-badge-tag" style="background:var(--quake-gold);color:#140a05;font-weight:700;">CURRENT</span>' : ''}
          </div>
          <span style="font-size:10px;color:var(--quake-text-muted);">${b.is_main ? 'Mainline' : 'Release'}</span>
        `;
        mainContainer.appendChild(item);
      });

      if (countEl) countEl.textContent = `${featureBranches.length} branch${featureBranches.length === 1 ? '' : 'es'}`;
      featureBranches.forEach(b => {
        const item = document.createElement("div");
        item.className = "branch-item" + (b.is_current ? " active" : "");
        item.onclick = () => { closeBranchModal(); onBranchSelected(b.name); };
        const isPR = b.name.toLowerCase().includes("pr") || b.name.toLowerCase().includes("pull");
        item.innerHTML = `
          <div style="display:flex;align-items:center;gap:6px;">
            <span style="color:${isPR ? 'var(--quake-purple)' : 'var(--quake-cyan)'};">${isPR ? '⎇' : '🌿'}</span>
            <span>${b.name}</span>
            ${b.is_current ? '<span class="node-badge node-badge-tag" style="background:var(--quake-gold);color:#140a05;font-weight:700;">CURRENT</span>' : ''}
          </div>
          <span style="font-size:10px;color:var(--quake-text-dim);">${isPR ? 'PR Branch' : 'Feature'}</span>
        `;
        featContainer.appendChild(item);
      });

      if (featureBranches.length === 0) {
        featContainer.innerHTML = '<div style="padding:10px;text-align:center;color:var(--quake-text-dim);font-size:11px;">No matching branches found</div>';
      }
    }

