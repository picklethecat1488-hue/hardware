#!/usr/bin/env bash
# ==============================================================================
# Helper script for remote execution and synchronization with cloud server anvil
# Usage:
#   bin/anvil sync                     # Sync local workspace to anvil
#   bin/anvil pull <file...>           # Download generated files/directories from anvil to local
#   bin/anvil fetch <file...>          # Alias for pull
#   bin/anvil stages [dir]             # Download all staged .rrd checkpoints from anvil
#   bin/anvil simulate [args...]       # Run simulation on anvil and auto-download resulting .rrd and staged checkpoints
#   bin/anvil smoke                    # Sync and run smoke tests on anvil
#   bin/anvil pytest [args...]         # Sync and run pytest on anvil
#   bin/anvil run <command...>         # Sync and run arbitrary command on anvil
#   bin/anvil stop                     # Stop daemon and terminate running processes on anvil
# ==============================================================================

set -e

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REMOTE_HOST="anvil"
REMOTE_DIR="/home/ubuntu/hardware"
REMOTE_CONDA="source /home/ubuntu/miniforge3/etc/profile.d/conda.sh && conda run -n cq --no-capture-output"
SSH_OPTS="-o ServerAliveInterval=30 -o ServerAliveCountMax=120 -o TCPKeepAlive=yes"

sync_code() {
    echo "📦 Syncing repository to ${REMOTE_HOST}:${REMOTE_DIR}..."
    rsync -az --delete \
        --exclude '.git' \
        --exclude 'build' \
        --exclude 'build_temp' \
        --exclude 'build_test_tmp' \
        --exclude 'tmp' \
        --exclude '__pycache__' \
        --exclude '*.pyc' \
        --exclude '.pytest_cache' \
        --exclude '.ruff_cache' \
        --exclude '*.rrd' \
        --exclude '*.mp4' \
        "${REPO_DIR}/" "${REMOTE_HOST}:${REMOTE_DIR}/"
}

pull_file() {
    local remote_path="$1"
    local local_dest="${2:-$1}"
    local local_dir
    local_dir="$(dirname "${REPO_DIR}/${local_dest}")"
    mkdir -p "${local_dir}"
    if ssh ${SSH_OPTS} "${REMOTE_HOST}" "[ -f '${REMOTE_DIR}/${remote_path}' ]" 2>/dev/null; then
        echo "📥 Downloading ${REMOTE_HOST}:${REMOTE_DIR}/${remote_path} -> ${REPO_DIR}/${local_dest}..."
        rsync -avz "${REMOTE_HOST}:${REMOTE_DIR}/${remote_path}" "${REPO_DIR}/${local_dest}"
        echo "✅ Download complete."
    else
        echo "⚠️ Remote file ${remote_path} was not found on ${REMOTE_HOST}."
    fi
}

pull_stages() {
    local target_dir="${1:-recordings}"
    mkdir -p "${REPO_DIR}/${target_dir}"
    echo "📥 Syncing all staged .rrd recordings from ${REMOTE_HOST}:${REMOTE_DIR}/${target_dir}/..."
    rsync -avz --include='*.rrd' --include='*/' --exclude='*' "${REMOTE_HOST}:${REMOTE_DIR}/${target_dir}/" "${REPO_DIR}/${target_dir}/"
    echo "✅ Staged recordings synced."
}

auto_download_simulate() {
    for arg in "$@"; do
        local file_path="${arg#*=}"
        if [[ "$file_path" == *.rrd ]] || [[ "$file_path" == *.mp4 ]]; then
            echo "📥 Auto-downloading generated artifact: ${file_path}..."
            pull_file "${file_path}"
        fi
    done
}

kill_remote_sim() {
    echo "🛑 Terminating preceding simulation and daemon processes on ${REMOTE_HOST}..."
    ssh ${SSH_OPTS} "${REMOTE_HOST}" "pkill -9 -f 'daemon.py|view.py' 2>/dev/null || true; rm -f ${REMOTE_DIR}/build/.daemon.* 2>/dev/null || true" 2>/dev/null || true
}

kill_remote_smoke() {
    echo "🛑 Terminating preceding smoke tests on ${REMOTE_HOST}..."
    ssh ${SSH_OPTS} "${REMOTE_HOST}" "pkill -9 -f 'smoke.py' 2>/dev/null || true" 2>/dev/null || true
}

kill_remote_pytest() {
    echo "🛑 Terminating preceding pytest runs on ${REMOTE_HOST}..."
    ssh ${SSH_OPTS} "${REMOTE_HOST}" "pkill -9 -f 'pytest' 2>/dev/null || true" 2>/dev/null || true
}

case "$1" in
    sync|push)
        sync_code
        echo "✅ Sync complete."
        ;;
    pull|fetch|get|download)
        shift
        if [ $# -eq 0 ]; then
            echo "Usage: bin/anvil pull <remote_path> [local_dest]"
            exit 1
        fi
        pull_file "$1" "$2"
        ;;
    stages|checkpoints)
        shift
        pull_stages "$1"
        ;;
    combine|merge)
        shift
        echo "✨ Combining staged RRD recordings..."
        python -c "
import sys, os, glob
sys.path.insert(0, os.path.abspath('src'))
from provider.utils import merge_rrd_recordings

args = sys.argv[1:]
out = 'recordings/sim_combined.rrd'
inputs = []
if '-o' in args:
    idx = args.index('-o')
    out = args[idx + 1]
    inputs = args[:idx] + args[idx + 2:]
else:
    inputs = args

if not inputs:
    inputs = sorted(glob.glob('recordings/sim_*.rrd'))

inputs = [f for f in inputs if os.path.abspath(f) != os.path.abspath(out)]
if not inputs:
    print('No input RRD files found to combine.')
    sys.exit(1)

merge_rrd_recordings(inputs, out)
print(f'✅ Successfully merged {len(inputs)} recording(s) into {out}')
" "$@"
        ;;
    kill|stop)
        kill_remote_sim
        kill_remote_smoke
        kill_remote_pytest
        echo "✅ Remote processes cleaned up on ${REMOTE_HOST}."
        ;;
    simulate)
        shift
        kill_remote_sim
        sync_code
        echo "🌊 Running simulation on ${REMOTE_HOST}..."
        trap kill_remote_sim INT TERM
        ssh ${SSH_OPTS} "${REMOTE_HOST}" "cd ${REMOTE_DIR} && ${REMOTE_CONDA} python src/view.py $*"
        trap - INT TERM
        auto_download_simulate "$@"
        ;;
    smoke)
        kill_remote_smoke
        sync_code
        echo "🚀 Running smoke test suite on ${REMOTE_HOST}..."
        trap kill_remote_smoke INT TERM
        ssh ${SSH_OPTS} "${REMOTE_HOST}" "cd ${REMOTE_DIR} && ${REMOTE_CONDA} pytest src/smoke.py"
        trap - INT TERM
        ;;
    pytest)
        shift
        kill_remote_pytest
        sync_code
        echo "🧪 Running pytest on ${REMOTE_HOST}..."
        trap kill_remote_pytest INT TERM
        ssh ${SSH_OPTS} "${REMOTE_HOST}" "cd ${REMOTE_DIR} && ${REMOTE_CONDA} pytest $*"
        trap - INT TERM
        ;;
    run|exec)
        shift
        sync_code
        echo "⚡ Executing command on ${REMOTE_HOST}: $*"
        ssh ${SSH_OPTS} "${REMOTE_HOST}" "cd ${REMOTE_DIR} && ${REMOTE_CONDA} $*"
        ;;
    *)
        if [ $# -eq 0 ]; then
            echo "Usage: bin/anvil {sync|pull|stages|simulate|smoke|pytest|run|stop} [args...]"
            exit 1
        fi
        sync_code
        echo "⚡ Executing command on ${REMOTE_HOST}: $*"
        ssh ${SSH_OPTS} "${REMOTE_HOST}" "cd ${REMOTE_DIR} && ${REMOTE_CONDA} $*"
        ;;
esac
