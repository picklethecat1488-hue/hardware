# Vast.ai Instance Configuration Example
# Automatically managed by: bin/anvil provision / bin/anvil release
# Can be placed in ~/.anvil.env (shared across repositories) or in .anvil.env (local override)
VAST_INSTANCE_ID="1234567"
REMOTE_HOST="ssh5.vast.ai"
REMOTE_PORT="34567"
REMOTE_USER="root"
REMOTE_KEY="~/.ssh/id_rsa"
# REMOTE_DIR="/workspace/firmware"

# Hardware Constraints (Prevent claiming old or overpriced junk hardware)
MIN_TOPS="50.0"       # Minimum compute throughput in TOPS / TFLOPS (default: 50.0)
MAX_COST="1.50"       # Maximum hourly rental cost in USD/hr (default: 1.50)
