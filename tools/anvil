#!/usr/bin/env python3
"""Unified Cloud Server (Anvil / Vast.ai) execution, reverse-proxy, and synchronization runner.

Supports:
  - Automated Vast.ai VM provisioning, bootstrapping, status inspection, and COB auto-release
  - Shared `~/.anvil.env` configuration across `firmware`, `hardware`, and `SSD`
  - Activity lock tracking (`~/.anvil.lock`) with automatic signal/exit cleanup
  - Reverse-proxying port 8899 (`-R 8899:127.0.0.1:8899`) to the local `tools/host.py` daemon
  - Remote `verify` (`./tools/verify.py`), `pytest`, `cargo`, `simulate`, and `smoke` execution
"""

import atexit
import glob
import os
from pathlib import Path
import shlex
import signal
import socket
import subprocess
import sys
import time
from typing import Callable, Dict, List, Optional, Sequence

DEFAULT_REMOTE_HOST: str = "anvil"
DEFAULT_REMOTE_USER: str = "root"
LOCAL_HOST_DAEMON_ADDR: str = "127.0.0.1"
LOCAL_HOST_DAEMON_PORT: int = 8899
BOOTSTRAP_MAX_ATTEMPTS: int = 5
BOOTSTRAP_RETRY_SEC: float = 3.0

SSH_BASE_OPTS: tuple[str, ...] = (
    "-o",
    "ServerAliveInterval=30",
    "-o",
    "ServerAliveCountMax=120",
    "-o",
    "TCPKeepAlive=yes",
    "-o",
    "StrictHostKeyChecking=accept-new",
)

RSYNC_EXCLUDES: tuple[str, ...] = (
    ".git",
    "/target",
    "/build",
    "/build_temp",
    "/build_test_tmp",
    "/tmp",
    "__pycache__",
    "*.pyc",
    ".pytest_cache",
    ".ruff_cache",
    ".mypy_cache",
    ".venv",
    "venv",
    "*.rrd",
    "*.mp4",
    "*.MOV",
    "*.mov",
    ".anvil.env*",
    ".anvil.lock*",
)

REMOTE_CARGO_PATH: str = (
    'export PATH="/workspace/miniforge3/bin:$HOME/.cargo/bin:/root/.cargo/bin:/home/ubuntu/.cargo/bin:$PATH" '
    "&& export OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 OMP_NUM_THREADS=1 "
    "NUMEXPR_NUM_THREADS=1 VECLIB_MAXIMUM_THREADS=1 PYTEST_XDIST_AUTO_NUM_WORKERS=8 "
    'XLA_FLAGS="--xla_cpu_multi_thread_eigen=false"'
